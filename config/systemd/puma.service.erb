[Unit]
Description = <%= fetch(:application) %> puma application server

[Socket]
ListenStream=0.0.0.0:9292
ListenStream=<%= shared_path %>/tmp/pids//puma.sock
NoDelay=true
ReusePort=true
Backlog=1024

[Service]
Environment = PATH=<%= fetch(:rbenv_path) %>/shims:/usr/local/bin:/usr/bin:/bin
Environment = RBENV_VERSION=<%= fetch(:rbenv_ruby) %>
Environment = RBENV_ROOT=<%= fetch(:rbenv_path) %>
Environment = RAILS_ENV=<%= fetch(:rails_env) %>
Environment = PWD=<%= current_path %>

WorkingDirectory = <%= current_path %>

ExecStart = <%= fetch(:rbenv_path) %>/bin/rbenv exec bundle exec puma -C <%= current_path %>/config/puma.rb
ExecStop=<%= fetch(:rbenv_path) %>/bin/rbenv exec bundle exec pumactl -F <%= current_path %>/config/puma.rb stop
ExecReload=<%= fetch(:rbenv_path) %>/bin/rbenv exec bundle exec pumactl -F <%= current_path %>/config/puma.rb phased-restart

PIDFile = <%= shared_path %>/tmp/pids/puma.pid
KillSignal = SIGQUIT
KillMode = process
TimeoutStopSec = 62
Restart = always

User = deploy
Group = deploy

[Install]
WantedBy = multi-user.target
