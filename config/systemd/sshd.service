[Unit]
Description=OpenBSD Secure Shell server
After=network.target auditd.service
ConditionPathExists=!/etc/ssh/sshd_not_to_be_run

[Service]
EnvironmentFile=-/etc/default/ssh
ExecStartPre=/usr/sbin/sshd -t -f /home/chuspace/chuspace.com/current/openssh/sshd_config
ExecStart=/usr/sbin/sshd -e -D -f /home/chuspace/chuspace.com/current/openssh/sshd_config
ExecReload=/usr/sbin/sshd -t -f /home/chuspace/chuspace.com/current/openssh/sshd_config
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartPreventExitStatus=255
Type=notify
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
Alias=sshd.service
