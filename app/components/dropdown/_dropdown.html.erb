<details class='relative' data-controller='dropdown'>
  <summary>
    <%= dropdown.opener %>
  </summary>

  <details-menu role="menu" class='dropdown'>
    <% dropdown.items.each do |item| %>
      <% if item.divider %>
        <%= content_tag :div, nil, class: 'dropdown__divider' %>
      <% else %>
        <%= link_to item.label.html_safe, item.url, class: 'link link--default dropdown__item', role: 'menuitem', tabindex: '-1', **item.options %>
      <% end %>
    <% end %>
  </details-menu>
</details>
