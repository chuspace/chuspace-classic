<%= content_tag :div, class: input.css_classes do %>
  <%= input.form.label input.name, class: 'input__label' %>
  <%= input.form.text_field input.name, type: input.type, class: 'input', placeholder: input.placeholder, **input.options %>
  <span class='input__error'><%= input.help_text %></span>
<% end %>
