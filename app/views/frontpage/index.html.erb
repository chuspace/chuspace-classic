<section class='list w-full mx-auto'>
  <h3 class='border-b border-grey-lightest pb-5 font-semibold'>Today</h3>

  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <%= render 'posts/post', post: post %>
    <% end %>
  <% else %>
    <div class='placeholder'>
      <h1 class='text-3xl'>No posts published yet</h1>
      <%= link_to 'Write a post', new_post_path, class: 'button button--fill mt-4 inline-block' %>
    </div>
  <% end %>
</section>
