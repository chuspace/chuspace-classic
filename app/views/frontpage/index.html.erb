<div class='block sm:flex justify-between'>
  <section class='list w-full hidden sm:block sm:w-1/4 mt-12'>
    <div class='border border-grey-lightest p-4'>
      <h1 class='text-base font-normal'>Publish a post</h1>
      <div class='py-8 text-center'>

      </div>
    </div>
  </section>

  <section class='list w-full sm:w-4/6'>
    <h3 class='border-b border-grey-lightest pb-5 font-semibold'>Today</h3>

    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <%= render 'posts/post', post: post %>
      <% end %>
    <% else %>
      <div class='placeholder'>
        <h1 class='text-xl'><%= t('frontpage.no_posts') %></h1>
      </div>
    <% end %>
  </section>
</div>
