<%= simple_form_for user, url: '/no-signup-allowed', remote: true do |f| %>
  <%= f.input :name, autofocus: true %>

  <input-check class='mt-2'>
    <%= f.input :nickname %>
  </input-check>

  <input-check class='mt-2'>
    <%= f.input :email %>
  </input-check>

  <div class='flex items-center mt-4'>
    <%= f.button :button, 'Sign up for Chuspace' %>
    <%# <%= link_to('Signin', signins_path, class: 'link link--default text-sm underline ml-4') %> %>
  </div>
<% end %>
