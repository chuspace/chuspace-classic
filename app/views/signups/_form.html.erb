<%= simple_form_for user, as: :signup, url: signups_path, remote: true do |f| %>
  <%= f.input :name, autofocus: true %>

  <input-check class='mt-2' url="<%= check_nicknames_path %>">
    <%= f.input :nickname %>
  </input-check>

  <input-check class='mt-2' url="<%= check_emails_path %>">
    <%= f.input :email %>
  </input-check>

  <div class='flex items-center mt-8'>
    <%= f.button :button, 'Sign up for Chuspace' %>
    <%= link_to('Sign in', signins_path, class: 'link link--default text-sm underline ml-4') %>
  </div>
<% end %>
