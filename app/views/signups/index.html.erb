<div class='mt-10'>
  <div class='container mx-auto'>
    <div class='intro w-1/2 mt-8'>
      <h2 class='title'>Sign up</h2>

      <p class='introduction mt-4'>
        Enter the email address associated with your account, and we’ll send a
        magic link to your inbox.
      </p>
    </div>

    <div class='form-body w-1/2 mt-8'>
      <%= form_with model: @user, remote: true do |form| %>
        <%= form.hidden_field :code, name: :code, value: @invite.code %>
        <%= component(
            'input',
            name: :name,
            form: form,
            css_class: 'mt-2 block mx-auto',
            placeholder: 'John Doe',
            help_text: @user.errors.messages_for(:name).to_sentence || t('signup.attributes.name.help_text'),
            options: { autocomplete: 'off', spellcheck: 'off', autofocus: true }
          )
        %>

        <input-check class='mt-2' name='nickname' url="<%= check_nicknames_path %>" status='<%= @status || 'ready' %>'>
          <%= component(
              'input',
              name: :nickname,
              form: form,
              css_class: 'mt-2 block mx-auto',
              placeholder: 'johndoe',
              help_text: @user.errors.messages_for(:nickname).to_sentence || t('signup.attributes.nickname.help_text'),
              options: { autocomplete: 'off', spellcheck: 'off' }
            )
          %>
        </input-check>

        <input-check class='mt-2' name='email' url="<%= check_signup_email_path %>" status='<%= @status || 'ready' %>'>
          <%= component(
              'input',
              type: :email,
              name: :email,
              form: form,
              css_class: 'mt-2 block mx-auto',
              placeholder: 'john@doe.com',
              help_text: @user.errors.messages_for(:email).to_sentence || t('signup.attributes.email.help_text'),
              options: { autocomplete: 'off', spellcheck: 'off' }
            )
          %>
        </input-check>

        <div class='flex items-center  mt-4'>
          <%= form.submit('Submit', class: 'button button--active mr-4') %>
          <%= link_to('← Go back', signups_path, class: 'link link--default block flex-1') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
