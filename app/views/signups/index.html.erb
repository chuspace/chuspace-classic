<div class='mt-10'>
  <div class='container w-1/3 mx-auto'>
    <div class='intro mt-8'>
      <h3 class='title font-bold'>Sign up</h3>

      <p class='introduction mt-4'>
        Enter the email address associated with your account, and we’ll send a
        magic link to your inbox.
      </p>
    </div>

    <div class='form-body mt-8'>
      <%= simple_form_for @user, remote: true do |form| %>
        <%= form.hidden_field :code, name: :code, value: @invite.code %>
        <%= component(
            'input',
            name: :name,
            form: form,
            css_class: 'mt-2 block mx-auto',
            placeholder: 'John Doe',
            options: { hint: t('signup.attributes.name.help_text') }
          )
        %>

        <input-check class='mt-2' url="<%= check_nicknames_path %>">
          <%= component(
              'input',
              name: :nickname,
              form: form,
              css_class: 'mt-2 block mx-auto',
              placeholder: 'johndoe',
              options: { hint: t('signup.attributes.nickname.help_text') }
            )
          %>
        </input-check>

        <input-check class='mt-2' url="<%= check_signup_email_path %>">
          <%= component(
              'input',
              type: :email,
              name: :email,
              form: form,
              css_class: 'mt-2 block mx-auto',
              placeholder: 'john@doe.com',
              options: { hint: t('signup.attributes.email.help_text') }
            )
          %>
        </input-check>

        <div class='flex items-center  mt-4'>
          <%= form.submit('Submit', class: 'button button--active mr-4') %>
          <%= link_to('← Go back', signups_path, class: 'link link--default block flex-1') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
