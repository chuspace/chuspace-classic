<div class='mt-10'>
  <div class='container w-1/3 mx-auto'>
    <div class='intro mt-8'>
      <h3 class='title font-bold'><%= t('.heading') %></h3>

      <p class='introduction mt-4'>
        <%= t('.intro') %>
      </p>
    </div>

    <div class='form-body mt-8'>
      <%= simple_form_for @user, remote: true do |f| %>
        <%= f.hidden_field :code, name: :code, value: @invite.code %>
        <%= f.input :name, class: 'mt-2' %>

        <input-check class='mt-2' url="<%= check_nicknames_path %>">
          <%= f.input :nickname, class: 'mt-2' %>
        </input-check>

        <input-check class='mt-2' url="<%= check_signup_email_path %>">
          <%= f.input :email, class: 'mt-2' %>
        </input-check>

        <div class='flex items-center mt-4'>
          <%= f.submit('Submit', class: 'button button--active mr-4') %>
          <%= link_to('Go back', signups_path, class: 'link link--default text-sm underline') %>
        </div>
      <% end %>
    </div>
  </div>
</div>
