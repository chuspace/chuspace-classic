<%= content_tag :div, class: 'list__item list__item--flex list__item--bordered' do %>
  <%= link_to publication_path(publication), class: 'flex items-center' do %>
    <%= component 'avatar', avatar: publication.avatar, variant: :md %>
    <div class='ml-4 flex-1'>
      <h6>
        <%= publication.name %>
        <% if defined?(badge) %>
          <span class='badge badge--grey font-normal'>
            <%= badge %>
          </span>
        <% end %>
      </h6>
      <%= content_tag :p, publication.description, class: 'text-grey text-sm mt-1' %>
    </div>
  <% end %>

  <%= yield %>
<% end %>
