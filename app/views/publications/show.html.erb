<% title @publication.name %>
<% description @publication.description %>
<% noindex %>

<%= render 'publications/header', publication: @publication %>

<div class='mt-12'>
  <%= render 'publications/tabs', publication: @publication %>
  <div class='flex'>
    <div class='w-full sm:w-2/3 mr-12'>
      <% if @posts.any? %>
        <div class='list'>
          <%= render partial: 'posts/post', collection: @posts %>
        </div>
      <% else %>
        <div class='placeholder'>
          <h1 class='text-xl'>This publication does not have any drafts yet</h1>
        </div>
      <% end %>
    </div>

    <% if signed_in? && allowed_to?(:publish?, @publication) %>
      <section class='list w-full hidden sm:block sm:w-1/3 mt-8'>
        <div class='border border-grey-lightest p-4'>
          <h1 class='text-base font-normal'>Publish a post</h1>
          <div class='py-8 text-center'>
            <%= link_to 'Write a post', new_publication_post_path(@publication), class: 'button button--fill' %>
          </div>
        </div>
      </section>
    <% end %>
  </div>
</div>
