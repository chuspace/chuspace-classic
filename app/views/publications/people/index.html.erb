<% title @publication.name %>
<% description @publication.description %>
<% noindex %>

<%= render 'publications/header', publication: @publication %>

<div class='mt-12'>
  <%= render 'publications/tabs', publication: @publication %>
  <div class='flex'>
    <div class='w-full sm:w-2/3 mr-12'>
      <div class='list'>
        <% @collaborators.each do |collaborator| %>
          <%= render 'users/user', badge: collaborator.role, user: collaborator.user do %>
            <% if Current.user.present? && allowed_to?(:update?, collaborator) %>
              <%= component 'dropdown', flush: true, drop_arrow: :no do |d| %>
                <% d.opener do %>
                  <svg-icon name='more-horizontal' feather='true'></svg-icon>
                <% end %>

                <% d.body do %>
                  <% Collaborator.roles.except(:owner).map do |role, _| %>
                    <% unless collaborator.role == role %>
                      <%= link_to "Make #{role}", publication_person_path(@publication, collaborator, role: role), class: "link link--default dropdown__item", role: "menuitem", tabindex: "-1", method: :patch, remote: true %>
                    <% end %>
                  <% end %>

                  <%= link_to "Remove from #{@publication.slug}", publication_person_path(@publication, collaborator), class: "link link--danger dropdown__item", role: "menuitem", tabindex: "-1", method: :delete, remote: true, 'data-confirm': 'Are you sure?' %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <section class='list w-full hidden sm:block sm:w-1/3 mt-8'>
      <% if signed_in? && allowed_to?(:invite?, @publication) %>
        <div class='border border-grey-lightest p-4' id='publication_invite_form'>
          <%= render 'publications/invitations/form', invitation: @invitation, publication: @publication %>
        </div>
      <% elsif signed_in? && allowed_to?(:publish?, @publication) %>
        <div class='border border-grey-lightest p-4'>
          <h1 class='text-base font-normal'>Publish a post</h1>
          <div class='py-8 text-center'>
            <%= link_to 'Write a post', new_publication_post_path(@publication), class: 'button button--fill' %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
