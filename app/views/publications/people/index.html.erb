<% title @publication.name %>
<% description @publication.description %>
<% noindex %>

<%= render 'publications/header', publication: @publication %>

<div class='mt-12'>
  <%= render 'publications/tabs', publication: @publication %>
  <div class='flex'>
    <div class='w-full sm:w-2/3 mr-12'>
      <div class='mt-8 list'>
        <% @collaborators.each do |collaborator| %>
          <div class='list__item list__item--flex list__item--bordered'>
            <%= link_to user_path(collaborator.user), class: 'flex items-center' do %>
              <%= component 'avatar', avatar: collaborator.user.avatar, gravatar: collaborator.user.gravatar, variant: :md %>
              <div class='ml-4 flex-1'>
                <h6><%= collaborator.user.name %>
                  <span class='badge badge--grey font-normal'>
              <%= collaborator.role %>
            </span>
            </h6>
                <%= content_tag :p, collaborator.user.bio, class: 'text-grey text-sm' %>
              </div>
            <% end %>

            <% if allowed_to?(:update?, collaborator) %>
              <%= component 'dropdown', flush: true, items: collaborator_actions(@publication, collaborator), drop_arrow: :no do |d| %>
                <% d.opener do %>
                  <svg-icon name='more-horizontal' feather='true'></svg-icon>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <section class='list w-full hidden sm:block sm:w-1/3 mt-8'>
      <% if allowed_to?(:invite?, @publication) %>
        <div class='border border-grey-lightest p-4'>
          <h1 class='text-base font-normal mb-8'>Add to publication</h1>
          <%= simple_form_for @invitation, url: publication_invitations_path(@publication), remote: true do |f| %>
            <auto-complete
              src="<%= autocomplete_publication_people_path(@publication) %>"
              aria-owns="users-popup"
              class='relative block'
            >
              <%= f.input :identifier, label: 'Email or Username', as: :autocomplete, autofocus: true, input_html: { popup_id: 'users-popup', class: 'input', autocomplete: 'off', spellcheck: 'off' } %>
              <%= f.input :role, as: :radio_buttons, collection: Collaborator::ROLES, checked: Collaborator::DEFAULT_ROLE, required: true %>
            </auto-complete>

            <div class='mt-8'>
              <%= f.submit 'Invite', class: 'button button--fill' %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class='border border-grey-lightest p-4'>
          <h1 class='text-base font-normal'>Publish a post</h1>
          <div class='py-8 text-center'>
            <%= link_to 'Write a post', new_publication_post_path(@publication), class: 'button button--fill' %>
          </div>
        </div>
      <% end %>
    </section>
  </div>
</div>
