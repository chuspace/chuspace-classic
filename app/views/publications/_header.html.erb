<div class='block sm:flex sm:items-center text-center sm:text-left w-full'>
  <div class='mr-4'>
    <%= render(AvatarComponent.new(avatar_url: publication.avatar_url(variant: :xl), type: :xl, css_class: 'mx-auto sm:mx-0')) %>
  </div>

  <div class='flex-1'>
    <h3 class='text-2xl mt-4 sm:mt-0'><%= publication.name %></h3>
    <%= content_tag :p, publication.description, class: 'text-sm mt-1 sm:w-1/2' %>

    <ul class='list-none flex items-center justify-center sm:justify-start p-0 m-0 mt-4 sm:mt-2'>
      <% publication.topics.each do |topic| %>
        <li class='list-none badge badge--grey mr-2'><%= topic %></li>
      <% end %>

      <% unless @publication.twitter.blank? %>
        <%= content_tag :li, class: 'ml-2' do %>
          <%= link_to sanitize(@publication.twitter), class: 'link link--active underline text-sm', target: '_blank', rel: 'noopener noreferer' do %>
            <svg-icon name='twitter' stroke="#1da1f2" color="#1da1f2" feather='true'></svg-icon>
          <% end %>
        <% end %>
      <% end %>

      <% unless @publication.website.blank? %>
        <%= content_tag :li, class: 'ml-2' do %>
          <%= link_to sanitize(@publication.website), class: 'link link--active underline text-sm', target: '_blank', rel: 'noopener noreferer' do %>
            <svg-icon name='link' feather='true'></svg-icon>
          <% end %>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>
