<div data-controller='login' class='centered mt-10'>
  <div class='card max-w-sm text-center'>
    <h2 class='card-title'>Sign in</h2>

    <p class='card-intro'>
      Enter the email address associated with your account, and we’ll send a
      magic link to your inbox.
    </p>

    <div class='card-body'>
      <%= form_with url: signins_path, data: { target: 'login.form', action: 'ajax:success->login#onFormSubmit' } do |form| %>
        <%= form.text_field(
          'email',
          autocomplete: 'email',
          placeholder: 'Enter email',
          autofocus: true,
          'data-target': 'login.inputEmail',
          class: 'input input-bordered input-bordered-green block mx-auto mb-2'
        ) %>
        <span class="alert alert-error text-left" data-target='login.inputEmailError'></span>
        <%= form.submit 'Submit', class: 'button button--active mt-4' %>
      <% end %>

      <span class="alert alert-success" data-target='login.formSuccess'></span>
    </div>

    <div class='card-footer'>
      <%= link_to('← Go back', signins_path, class: 'link') %>
    </div>
  </div>
</div>
