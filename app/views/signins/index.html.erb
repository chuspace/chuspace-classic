<main class='container mt-24 w-1/3'>
  <section>
    <h3 class='font-bold'><%= t('.heading') %></h3>
    <p class='mt-4'>
      <%= t('.intro') %>
    </p>
  </section>

  <section class='mt-4'>
    <%= simple_form_for @user, url: signins_path do |f| %>
      <%= f.input :email, autofocus: true %>
      <div class='flex items-center mt-4'>
        <%= f.button :button, 'Login' %>
        <%= link_to('Signup', root_path, class: 'link text-sm underline ml-4') %>
      </div>
    <% end %>
  </section>
</main>
