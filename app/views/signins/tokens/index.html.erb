<main class='container sm:mt-24 w-full sm:w-1/2'>
  <section>
    <h3 class='font-bold'><%= t('.heading') %></h3>
    <p class='mt-4'>
      <%= t('.intro') %>
    </p>
  </section>

  <section class='mt-8'>
    <%= simple_form_for @user, url: signin_token_index_path, remote: true do |f| %>
      <%= f.input :auth_token, autofocus: true, required: true %>
      <div class='flex items-center mt-8'>
        <%= f.button :button, 'Login' %>
        <%= link_to('Request a new one', signins_path, class: 'link text-sm underline ml-4') %>
      </div>
    <% end %>
  </section>
</main>
