<%= render 'posts/draft', draft: post, show_placeholder: true %>

<%= simple_form_for post, scope: :post, url: publication_post_publish_index_path(publication, post), method: :post, remote: true do |f| %>
  <div class='w-full'>
    <%= content_tag :span, post.errors.full_messages_for(:title).to_sentence, class: 'input__error text-red block' %>
    <%= content_tag :span, post.errors.full_messages_for(:summary).to_sentence, class: 'input__error text-red block' %>
    <%= content_tag :span, post.errors.full_messages_for(:preview_image).to_sentence, class: 'input__error text-red block' %>

    <input-autocomplete
      url="<%= autocomplete_topics_path %>"
      items='<%= post.topics || [] %>'
      name='post[topics][]'
      maxlength="5"
      keys="name"
      class='w-full block mt-12'
    >
      <div class='form_field__container'>
        <div class='input__container input__container__label--floating' data-label='Topics'>
          <div class='autocomplete__selections'>
            <% post.topics&.each do |topic| %>
              <span class="autocomplete__item mr-2">
                <%= topic %>
                <svg-icon class='autocomplete__item__icon' name='x-circle' width='10' height='10' feather='true' color='none'>&#10005</svg-icon>
              </span>
            <% end %>
          </div>

          <div class='input__dropdown__group relative'>
            <input type='text' class="input autocomplete__input" name='post[topics][]' autocomplete='off' spellcheck='off' autofocus />
          </div>
        </div>

        <% if post.errors.include?(:topics) %>
          <%= content_tag :span, post.errors.full_messages_for(:topics).to_sentence, class: 'input__error text-red block' %>
        <% else %>
          <span class="input__hint">Select topics to help readers find your post</span>
        <% end %>
      </div>
    </input-autocomplete>

    <%= f.input :canonical_url, label: false, input_container_html: { class: 'input__container__label--floating', 'data-label': 'Canonical' } %>

    <auto-complete
      src="<%= publication_post_autocomplete_index_path(publication, post) %>"
      aria-owns="posts-popup"
      class='relative block'
    >
      <%= f.input :parent, label: false, as: :autocomplete, input_container_html: { class: 'input__container__label--floating', data: { label: 'Parent' } }, input_html: { popup_id: 'posts-popup', class: 'input', value: post.parent&.slug } %>
    </auto-complete>

    <div class='float-left mt-8'>
      <%= f.submit 'Publish now', class: 'button button--fill mr-2', data: { 'disable-with': 'Publishing...' } %>
      <%= link_to 'Back to editor', edit_publication_post_path(publication, post), class: 'button button--default inline-block' %>
    </div>

    <%= link_to 'Delete', publication_post_path(publication, post), method: :delete, class: 'button button--danger float-right mt-8 text-base', data: { confirm: 'Are you sure you want to delete this post?' } %>
  </div>
<% end %>
