<dialog class='dialog__full' data-controller='publish'>
  <div class='container relative'>
    <%= link_to edit_publication_post_path(@publication, @post) do %>
      <svg-icon
        class='absolute top-0 right-0'
        name='x-circle'
        feather='true'
        stroke='rgba(0, 0, 0, 0.5)'
        color='none' width='24' height='24'>
      </svg-icon>
    <% end %>

    <h3 class='border-b pb-2 inline-block text-lg'>Publish</h3>
    <div class='card card--default w-2/3 mx-auto mt-16 list' id='publish_form'>
      <%= render 'posts/publish/form', publication: @publication, post: @post %>
    </div>
  </div>
</dialog>
