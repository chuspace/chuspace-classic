<article class='py-6'>
  <div class='header'>
    <h4 class='pb-4'>
      <%= post.title || post.draft_title %>
    </h4>
    <%= content_tag :p, post.summary, class: 'text-grey tracking-normal text-sm leading-normal' if post.summary %>
  </div>
  <div class='author mt-4'>
    <p class='text-sm text-grey'>
      By <span><%= post.author.name %></span>
    </p>

    <% if defined?(post.published_at) %>
      <time class='text-sm text-grey'><%= post.published_at  %></time>
    <% end %>

    <%= link_to 'Edit', edit_post_path(post) %>
  </div>
</article>
