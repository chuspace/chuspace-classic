<% @editor_header = capture do %>
  <div class='flex items-center ml-4'>
    <div class="mr-4"><%= @post.author.name %></div>
    <div class="mr-4 badge badge--grey"><%= @post.status.titlecase %></div>
    <div class="mr-4 text-grey text-sm" id='editor-status'>Saved</div>
  </div>

  <div class='flex justify-end items-center flex-1 mr-8'>
    <dialog-opener class='button button--active button--slim mr-2' target='publish-<%= @post.slug %>'>Publish</dialog-opener>
    <%= link_to 'Delete', post_path(@post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'button button--danger button--slim' %>
  </div>
<% end %>

<chu-editor
  spellcheck="false"
  url="<%= post_path(@post) %>"
  method="PATCH"
  content="<%= @post.blob_content %>"
  id="<%= @post.slug %>"
  class='chu-editor'
>
</chu-editor>


<dialog id='publish-<%= @post.slug %>' class='dialog__sm'>
  <div class='container relative'>
    <%= link_to edit_post_url(@post) do %>
      <svg-icon
        class='absolute top-0 right-0'
        name='x-circle'
        feather='true'
        stroke='rgba(0, 0, 0, 0.5)'
        color='none' width='24' height='24'>
      </svg-icon>
    <% end %>

    <h3 class='border-b pb-2 inline-block text-lg'>Publish</h3>
    <div class='card card--default w-3/4 mx-auto mt-8'>
      <%= simple_form_for @post, remote: true, onSubmit: "return !event.keyCode === 13" do |f| %>
        <h1 id="title" class='title title--nohover text-3xl'></h1>
        <h2 id="summary" class='summary summary--nohover text-grey-light mt-8 text-2xl'></h2>

        <input-autocomplete
          url="<%= autocomplete_topics_url %>"
          items='<%= @post.topics %>'
          maxlength="5"
          label="Topics"
          keys="name"
          placeholder="Type to add topics"
          hint="<%= t('form.hints.post.topics') %>"
          class='w-full block mt-12'
          noresults
        >
        </input-autocomplete>

        <input-autocomplete
          url="<%= autocomplete_posts_url %>"
          items='[<%= @post.parent %>]'
          maxlength="1"
          label="Parent"
          keys="slug"
          placeholder="Type to select a post"
          hint="<%= t('form.hints.post.parent') %>"
          class='w-full block mt-12'>
        </input-autocomplete>

        <%= f.submit 'Publish now', class: 'button button--fill float-right mt-12 text-base button--disabled' %>
      <% end %>
    </div>
  </div>
</dialog>
