<chu-editor
  spellcheck="false"
  content="<%= @post.blob_content %>"
  id="<%= @post.slug %>"
  imageProviderPath='<%= publication_images_path(@post.publication) %>'
  class='chu-editor'
  channel='PostChannel'
  editable
>
</chu-editor>

<%= render 'posts/publish', post: @post if params[:controller] == 'posts/publish' %>
