<chu-editor
  spellcheck="false"
  url="<%= post_path(@post) %>"
  method="PATCH"
  content="<%= @post.blob_content %>"
  id="<%= @post.slug %>"
  class='chu-editor'
  channel='PostChannel'
  editable
>
</chu-editor>

<%= render 'posts/publish', post: @post if params[:controller] == 'posts/publish' %>
