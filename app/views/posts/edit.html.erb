<%= render 'form', url: post_path(@post), method: 'PATCH', content: @post.draft_body, id: @post.slug  %>

<dialog id='publish-<%= @post.slug%>' class='dialog__sm'>
  <div class='container relative'>
    <%= link_to edit_post_url(@post) do %>
      <svg-icon
        class='absolute top-0 right-0'
        name='x-circle'
        feather='true'
        stroke='rgba(0, 0, 0, 0.5)'
        color='none' width='24' height='24'>
      </svg-icon>
    <% end %>

    <h3 class='border-b pb-2 inline-block text-lg'>Publish</h3>

    <div class='card card--default w-3/4 mx-auto'>
      <%= simple_form_for @post, remote: true do |f| %>
        <div class='chu-editor'>
          <h1 id="title" class='title title--nohover text-4xl'></h1>
          <h2 id="summary" class='summary summary--nohover text-grey-light mt-12'></h2>
        </div>

        <chu-topics
          topics='<%= @post.topics %>'
          maxlength="5"
          placeholder="Add topics"
          hint="<%= t('form.hints.post.topics')%>"
          class='w-full block mt-12'>
        </chu-topics>

        <%= f.submit 'Publish now', class: 'button button--active float-right mt-8 text-base font-headings button--disabled' %>
      <% end %>
    </div>
  </div>
</dialog>
