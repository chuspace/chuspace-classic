<chu-editor
  spellcheck="false"
  url="<%= post_path(@post) %>"
  method="PATCH"
  content="<%= @post.blob_content %>"
  id="<%= @post.slug %>"
  class='chu-editor'
  editable
>
</chu-editor>

<dialog id='publish-<%= @post.slug %>' class='dialog__sm'>
  <div class='container relative'>
    <svg-icon
      class='absolute top-0 right-0'
      name='x-circle'
      feather='true'
      stroke='rgba(0, 0, 0, 0.5)'
      color='none' width='24' height='24'>
    </svg-icon>

    <h3 class='border-b pb-2 inline-block text-lg'>Publish</h3>
    <div class='card card--default w-3/4 mx-auto mt-8'>
      <%= simple_form_for @post, scope: :post, url: post_publish_index_path(@post), method: :post, remote: true do |f| %>
        <h1 id="post_title" class='title title--nohover text-3xl'></h1>
        <h2 id="post_summary" class='summary summary--nohover text-grey-light mt-8 text-2xl'></h2>

        <input-autocomplete
          url="<%= autocomplete_topics_url %>"
          items='<%= @post.topics %>'
          maxlength="5"
          label="Topics"
          keys="name"
          name="post[topics][]"
          placeholder="Type to add topics"
          hint="<%= t('form.hints.post.topics') %>"
          class='w-full block mt-12'
          noresults
        >
        </input-autocomplete>

        <input-autocomplete
          url="<%= autocomplete_posts_url %>"
          items='[<%= @post.parent %>]'
          maxlength="1"
          label="Parent"
          keys="slug"
          name="post[parent]"
          placeholder="Type to select a post"
          hint="<%= t('form.hints.post.parent') %>"
          class='w-full block mt-12'>
        </input-autocomplete>

        <%= f.submit 'Publish now', class: 'button button--fill float-right mt-12 text-base' %>
      <% end %>
    </div>
  </div>
</dialog>
