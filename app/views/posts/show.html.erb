<% set_meta_tags @post %>

<%= render 'posts/series', post: @post %>

<article class='relative'>
  <% if Current.user.present? && allowed_to?(:republish?, @post) %>
    <div class='flex justify-between items-center card card-default mb-8'>
      <%= content_tag :p, 'You have made some changes to this post.' %>
      <%= link_to 'Republish', publication_post_publish_index_path(@post.publication, @post), class: 'button button--fill' %>
    </div>
  <% end %>

  <%= content_tag :h1, @post.title, class: 'title' %>
  <%= content_tag :h2, @post.summary, class: 'summary' %>

  <div class='mt-8'>
    <%= link_to user_path(@post.author), class: 'flex items-center' do %>
      <%= component 'avatar', avatar_url: @post.author.avatar_url(variant: :sm), gravatar_url: @post.author.gravatar_url(variant: :sm), variant: :sm %>
      <div class='ml-2 flex-1 text-sm'>
        <p class='font-medium'><%= @post.author.name %></p>
        <div class='horizontal__list text-grey text-xs'>
          <%= content_tag :li, @post.published_at.strftime("%b %d, %Y") %>
          <%= content_tag :li do %>
            <%= @post.reading_time %> min read
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class='chu-editor mt-8'>
    <%= @post.body_html.html_safe %>
  </div>

  <ul class='list-none flex p-0 m-0'>
    <% @post.topics.each do |topic| %>
      <li class='list-none badge badge--grey mr-2'><%= topic %></li>
    <% end %>
  </ul>

  <div class='mt-12 flex'>
    <div class='flex-1' id='<%= @post.slug %>_container'>
      <%= render 'posts/likes', publication: @post.publication, post: @post %>
    </div>

    <div class='flex'>
      <%= link_to publication_post_share_path(@post.publication, @post, 'twitter'), class: 'mr-4', target: '_blank', rel: 'noopener noreferrer nofollow' do %>
        <svg-icon name='twitter' feather='true' width='24' height='24' stroke='#1da1f2' color='#1da1f2'></svg-icon>
      <% end %>

      <%= link_to publication_post_share_path(@post.publication, @post, 'facebook'), target: '_blank', rel: 'noopener noreferrer nofollow' do %>
        <svg-icon name='facebook' feather='true' width='24' height='24' stroke='#3b5998' color='#3b5998'></svg-icon>
      <% end %>
    </div>
  </div>

  <div class='author mt-4 mb-24 border-t border-grey-lightest'>
    <div class='list'>
      <p class='text-grey'>Written by</p>
      <%= render 'users/user', badge: 'author', user: @post.author %>
      <%= render 'publications/publication', badge: 'publication', publication: @post.publication unless @post.publication.personal %>
    </div>
  </div>
</article>
