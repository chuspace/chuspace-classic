<div class='flex container' data-controller="markdown">
  <div class='post__sidebar mt-24 w-1/4'>
    <%= link_to user_path(@post.author) do %>
      <div class='author mx-auto text-center'>
        <%= component 'avatar',
          avatar: @post.author.avatar,
          initials: @post.author.initials,
          variant: :md,
          css_class: 'block mx-auto'
        %>

        <h3 class='text-base mt-4'><%= @post.author.name %></h3>
        <%= content_tag :p, @post.author.bio, class: 'text-grey text-sm' unless @post.author.bio.blank? %>
        <%= content_tag :time, @post.formatted_published_at, class: 'text-grey text-xs' if @post.published? %>
      </div>
    <% end %>

    <% if @post.tree.size > 1 %>
      <div class='post__ancestry mt-16 w-5/6'>
        <h3 class='text-sm font-bold mb-4 border-b border-grey-lightest pb-2'>In this series:</h3>
        <% @post.tree.each do |post| %>
          <%= link_to(
            post.title,
            post_path(post),
            class: "#{link_class(post_path(post))} text-sm text-grey block mt-2 indent__#{post.depth}"
          )
          %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class='post__body w-3/4 mx-auto'>
    <%= content_tag :p, 'You are viewing the unpublished version.', class: 'card card-default' if @post.author == Current.user && @post.outdated? %>

    <div class='chu-editor'>
      <%= @post.body_html.html_safe %>
    </div>

    <ul class='list-none flex p-0 m-0'>
      <% @post.topics.each do |topic| %>
        <li class='list-none badge badge--grey mr-2'><%= topic %></li>
      <% end %>
    </ul>
  </div>
</div>
