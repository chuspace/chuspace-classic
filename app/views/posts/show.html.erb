<% set_meta_tags @post %>

<div class='block md:flex container' data-controller="markdown">
  <%= render 'posts/sidebar', post: @post %>

  <div class='post__body w-full md:w-3/4  mx-auto'>
    <% if policy(@post).publish? %>
      <div class='flex justify-between items-center card card-default'>
        <%= content_tag :p, 'You have made some changes to this post.' %>
        <%= link_to 'Republish', post_publish_index_path(@post), class: 'button button--fill' %>
      </div>
    <% end %>

    <div class='chu-editor'>
      <%= @post.body_html.html_safe %>
    </div>

    <ul class='list-none flex p-0 m-0'>
      <% @post.topics.each do |topic| %>
        <li class='list-none badge badge--grey mr-2'><%= topic %></li>
      <% end %>
    </ul>
  </div>
</div>
