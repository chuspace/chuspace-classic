<div class='w-1/2 mx-auto' data-controller="markdown">
  <%= content_tag :p, 'You are viewing the unpublished version.', class: 'card card-default' if @post.author == Current.user && @post.outdated? %>
  <div class='chu-editor'>
    <%= @post.body_html.html_safe %>
  </div>

  <ul class='list-none flex p-0 m-0'>
    <% @post.topics.each do |topic| %>
      <li class='list-none badge badge--grey mr-2'><%= topic %></li>
    <% end %>
  </ul>
</div>
