<div class='flex items-center'>
  <%= link_to publication_post_likes_path(publication, post), method: :post, remote: true do %>
    <% if @post.liked_by?(user: Current.user) %>
      <svg-icon name='heart' feather='true' width='32' height='32' color='#FF2800' stroke='#FF2800'></svg-icon>
    <% else %>
      <svg-icon name='heart' feather='true' width='32' height='32' stroke='#FF2800'></svg-icon>
    <% end %>
  <% end %>

  <span class='ml-1'><%= post.likes_count %></span>
</div>
