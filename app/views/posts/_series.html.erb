<% if post.tree.size > 1 %>
  <div class='series__list md:mt-16 text-left'>
    <h3 class='text-sm font-bold mb-4 border-b border-grey-lightest pb-2'>In this series:</h3>
    <% post.tree.each do |post| %>
      <%= link_to(
        post.title,
        publication_post_path(post.publication, post),
        class: "#{link_class(publication_post_path(post.publication, post))} text-sm text-grey block mt-2 indent__#{post.depth}"
      )
      %>
    <% end %>
  </div>
<% end %>
