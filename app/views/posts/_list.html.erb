<section class='post-list mt-20'>
  <h3 class='border-b mb-4 pb-2'>Latest</h3>
  <% @posts.each do |post| %>
    <%= link_to post_path(post) do %>
      <article class='py-6'>
        <div class='header'>
          <h4 class='pb-4'>
            <%= post.title %>
          </h4>
          <%= content_tag :p, post.excerpt, class: 'text-grey tracking-normal text-sm leading-normal' if post.excerpt %>
        </div>
        <div class='author mt-4'>
          <p class='text-sm text-grey'>
            By <span><%= post.author.name %></span>
          </p>
          <time class='text-sm text-grey'><%= post.published_at %></time>
          <%= link_to 'Edit', edit_post_path(post) %>
        </div>
      </article>
    <% end %>
  <% end %>
</section>
