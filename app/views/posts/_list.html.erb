<section class='post-list'>
  <h3 class='mt-12 border-b pb-2'>Latest</h3>
  <% @posts.each do |post| %>
    <%= link_to blog_post_path(blog_slug: blog.slug, slug: post.slug) do %>
      <article class='py-6'>
        <div class='flex'>
          <div class='w-4/5 pr-16'>
            <h4 class='pb-4'>
              <%= post.title %>
            </h4>
            <p class='text-grey tracking-normal text-sm leading-normal'>
              <%= post.title %>
            </p>
          </div>
        </div>
        <div class='author mt-4'>
          <p class='text-sm text-grey'>
            By <span><%= post.author.name %></span>
          </p>
          <time class='text-sm text-grey'><%= post.published_at %></time>
        </div>
      </article>
    <% end %>
  <% end %>
</section>
