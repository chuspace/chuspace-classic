<%= content_tag :div, class: 'list__item list__item--bordered' do %>
  <article>
    <%= link_to post_path(post) do %>
      <div class='header'>
        <h4><%= post.title %></h4>
        <%= content_tag :p, post.summary, class: 'text-grey tracking-normal text-sm leading-normal mt-2' %>
      </div>
    <% end %>

    <ul class='horizontal__list text-xs mt-4'>
      <li>
        Last edited <%= distance_of_time_in_words_to_now(post.updated_at) %> ago
      </li>
      <li>
        Published at <time><%= distance_of_time_in_words_to_now(post.published_at) %></time>
      </li>
      <% if policy(post).edit? %>
        <li>
          <%= link_to 'Edit', edit_post_path(post), class: 'link link--active underline' %>
        </li>
        <li>
          <%= link_to 'Delete',
            post_path(post),
            method: :delete,
            remote: true,
            class: 'link link--danger underline',
            data: { confirm: 'Are you sure?' }
          %>
        </li>
      <% end %>
    </ul>
  </article>
<% end %>
