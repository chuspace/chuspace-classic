<%= link_to post_path(post), class: 'list__item list__item--bordered' do %>
  <article>
    <div class='header'>
      <h4><%= post.title %></h4>
      <%= content_tag :p, post.summary, class: 'text-grey tracking-normal text-sm leading-normal w-2/3' %>
    </div>

    <div class='author mt-4'>
      <p class='text-sm text-grey'>
        By <span><%= post.author.name %></span>
      </p>

      <time class='text-sm text-grey'><%= post.published_at  %></time>
      <%= link_to 'Edit', edit_post_path(post) %>
    </div>
  </article>
<% end %>
