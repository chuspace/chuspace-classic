<%= link_to post_path(post), class: 'list__item list__item--bordered' do %>
  <article>
    <div class='header'>
      <h4><%= post.title %></h4>
      <%= content_tag :p, post.summary, class: 'text-grey tracking-normal text-sm leading-normal w-2/3' %>
    </div>

    <ul class='horizontal__list text-xs mt-2'>
      <li>
        Last edited <%= distance_of_time_in_words_to_now(post.updated_at) %> ago
      </li>
      <li>
        Published at <time class='text-sm text-grey'><%= post.published_at  %></time>
      </li>
      <li>
        <%= link_to 'Edit', edit_post_path(post), class: 'link link--active underline', %>
      </li>
      <li>
        <%= link_to 'Delete',
          post_path(draft),
          method: :delete,
          remote: true,
          class: 'link link--danger underline',
          data: { confirm: 'Are you sure?' }
        %>
      </li>
    </ul>
  </article>
<% end %>
