<% if post.draft? %>
  <%= render 'posts/draft', draft: post %>
<% else %>
  <%= content_tag :div, class: 'list__item list__item--bordered' do %>
    <article>
      <%= link_to publication_post_path(post.publication, post) do %>
        <div class='header'>
          <h3 class='font-content'><%= post.title %></h3>
          <%= content_tag :p, post.summary, class: 'text-grey mt-1' %>
        </div>
      <% end %>

      <ul class='horizontal__list text-sm text-grey mt-4'>
        <li>
          By <%= link_to post.author.name, user_path(post.author), class: 'underline' %>
        </li>
        <% unless post.publication.personal? %>
          <li>
            in
            <%= link_to post.publication.name, publication_path(post.publication), class: 'underline' %>
          </li>
        <% end %>
        <li>
          <time><%= post.published_at.strftime("%b %d, %Y") %></time>
        </li>
        <% if Current.user.present? && allowed_to?(:edit?, post) %>
          <li>
            <%= link_to 'Edit', edit_publication_post_path(post.publication, post), class: 'link link--active underline' %>
          </li>
          <li>
            <%= link_to 'Delete',
              publication_post_path(post.publication, post),
              method: :delete,
              remote: true,
              class: 'link link--danger underline',
              data: { confirm: 'Are you sure?' }
            %>
          </li>
        <% end %>
      </ul>
    </article>
  <% end %>
<% end %>
