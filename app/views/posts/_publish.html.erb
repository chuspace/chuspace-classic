<dialog class='dialog__sm' data-controller='publish'>
  <div class='container relative'>
    <%= link_to edit_post_path(post) do %>
      <svg-icon
        class='absolute top-0 right-0'
        name='x-circle'
        feather='true'
        stroke='rgba(0, 0, 0, 0.5)'
        color='none' width='24' height='24'>
      </svg-icon>
    <% end %>

    <h3 class='border-b pb-2 inline-block text-lg'>Publish</h3>
    <div class='card card--default w-3/4 mx-auto mt-8'>
      <%= simple_form_for post, scope: :post, url: post_publish_index_path(post), method: :post, remote: true do |f| %>
        <h1 class='title__label title__label--nohover text-3xl'><%= post.title %></h1>
        <%= content_tag :span, post.errors.full_messages_for(:title).to_sentence, class: 'input__error text-red block' if post.errors.include?(:title) %>
        <h2 class='summary__label summary__label--nohover text-grey-light mt-8 text-2xl'><%= post.summary %></h2>
        <%= content_tag :span, post.errors.full_messages_for(:summary).to_sentence, class: 'input__error text-red block' if post.errors.include?(:summary) %>

        <input-autocomplete
          url="<%= autocomplete_topics_url %>"
          items='<%= post.topics || [] %>'
          maxlength="5"
          keys="name"
          class='w-full block mt-12'
          noresults
        >
          <div class='autocomplete__selections'>
            <% post.topics&.each do |topic| %>
              <span class="autocomplete__item mr-2">
                <%= topic %>
                <svg-icon class='autocomplete__item__icon' name='x-circle' width='10' height='10' feather='true' color='none'>&#10005</svg-icon>
              </span>
            <% end %>
          </div>

          <div class='form_field__container'>
            <div class='input__container input__container__label--floating' data-label='Topics'>
              <input type='text' class = "input autocomplete__input" >
            </div>
            <span class="input__hint">Select topics to help readers find your post</span>
          </div>

          <%= f.input :topics, as: :hidden, input_html: { id: 'selections__input', value: post.topics_list } %>
        </input-autocomplete>

        <%= f.input :canonical_url, label: false, input_container_html: { class: 'input__container__label--floating', 'data-label': 'Canonical' } %>
        <%= f.input :parent, label: false, collection: @published_posts, selected: post.parent&.slug, value_method: :slug, label_method: :slug, input_container_html: { class: 'input__container__label--floating', data: { label: 'Parent' } }, prompt: "Choose a parent post" %>
        <%= f.submit 'Publish now', class: 'button button--fill float-right mt-12 text-base' %>
      <% end %>
    </div>
  </div>
</dialog>
