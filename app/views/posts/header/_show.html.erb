<div class='flex items-center flex-1 ml-4'>
  <% unless @publication.personal %>
    <%= link_to publication_path(@publication), class: "mr-4" do %>
      <%= component(
          'avatar',
          avatar_url: @publication.avatar_url || @publication.owner.avatar_url,
          gravatar_url: @publication.owner.gravatar_url,
          variant: :xs
        )
      %>
    <% end %>
  <% end %>

  <div class='flex justify-end items-center flex-1 mr-4'>
    <%= link_to 'Edit', edit_publication_post_path(@publication, post), class: 'button button--active button--slim mr-2' if Current.user.present? && allowed_to?(:edit?, post) %>
  </div>
</div>
