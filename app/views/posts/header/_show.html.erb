<div class='flex items-center flex-1 ml-4'>
  <% unless @publication.personal %>
    <%= link_to publication_path(@publication), class: "mr-4" do %>
      <%= component(
          'avatar',
          avatar_url: @publication.avatar_url || @publication.owner.avatar_url,
          gravatar_url: @publication.owner.gravatar_url,
          variant: :xs
        )
      %>
    <% end %>
  <% end %>

  <% if signed_in? && allowed_to?(:edit?, post) %>
    <div class='flex justify-end items-center flex-1 mr-2'>
      <%= render 'posts/header/actions', publication: @publication, post: post %>
    </div>
  <% end %>
</div>
