<div class='flex items-center flex-1' id='post_header'>
  <div class='flex-1 flex items-center ml-4 sm:ml-8'>
    <div class="mr-4 badge badge--grey"><%= post.status.titlecase %></div>
    <div class="text-grey text-sm" id='editor-status'><%= post.status_label %></div>
  </div>

  <div class='block sm:hidden'>
    <%= component 'dropdown', flush: true, items: edit_items(post), drop_arrow: :no do |d| %>
      <% d.opener do %>
        <svg-icon name='more-horizontal' class='mr-4 block' width='30' height='30' feature='true'></svg-icon>
      <% end %>
    <% end %>
  </div>

  <div class='flex justify-end items-center flex-1 mr-8 hidden sm:block'>
    <%= link_to post.publish_label, post_publish_index_path(post), class: 'button button--active button--slim mr-2' if policy(post).publish? %>
    <%= link_to 'Delete', post_path(post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'button button--danger button--slim' if policy(post).destroy? %>
  </div>
</div>
