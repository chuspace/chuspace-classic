<div class='flex items-center flex-1' id='post_header'>
  <div class='flex-1 flex items-center ml-4'>
    <%= link_to publication_path(@publication), class: "mr-4" do %>
      <%= component 'avatar', avatar: @publication.avatar, gravatar: @publication.owner.gravatar, variant: :sm %>
    <% end %>
    <div class="mr-4 badge badge--grey"><%= post.status.titlecase %></div>
    <div class="text-grey text-sm" id='editor-status'><%= post.status_label %></div>
  </div>

  <div class='block sm:hidden'>
    <%= component 'dropdown', flush: true, items: edit_items(@publication, post), drop_arrow: :no do |d| %>
      <% d.opener do %>
        <svg-icon name='more-horizontal' class='mr-4 block' width='30' height='30' feature='true'></svg-icon>
      <% end %>
    <% end %>
  </div>

  <div class='justify-end items-center flex-1 mr-8 hidden sm:flex'>
    <%= link_to post.publish_label, publication_post_publish_index_path(@publication, post), class: 'button button--active button--slim mr-2' if allowed_to?(:publish?, post) %>
    <%= link_to 'Delete', publication_post_path(@publication, post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'button button--danger button--slim' if allowed_to?(:destroy?, post) %>
  </div>
</div>
