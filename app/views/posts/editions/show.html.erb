<div class='flex container'>
  <div class='post__sidebar mt-24 w-1/4'>
    <p class='text-center mb-4 font-semibold'>Author</p>
    <%= render 'users/badge', user: @post.author %>

    <div class='mt-16'>
      <p class='text-center mb-4 font-semibold'>Editor</p>
      <%=  render 'users/badge', user: @edition.editor %>
    </div>

    <% if @post.editions.size > 1 %>
      <div class='post__ancestry mt-16 w-5/6'>
        <h3 class='text-sm font-bold mb-4 border-b border-grey-lightest pb-2'>More editions:</h3>
        <% @post.editions.each do |edition| %>
          <%= link_to(
            "#{edition.editor.name} made changes",
            post_edition_path(@post, edition),
            class: "#{link_class( post_edition_path(@post, edition))} text-sm text-grey block mt-2"
          )
          %>
          <time class='text-xs'><%= time_ago_in_words(@edition.created_at)  %> ago</time>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class='post__body w-3/4 mx-auto'>
    <chu-editor
      spellcheck="false"
      original="<%= @post.blob_content %>"
      content="<%= @edition.blob_content %>"
      class='chu-editor'
      showDiff
    >
    </chu-editor>
  </div>
</div>
