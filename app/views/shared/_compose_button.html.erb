<%= render(DropdownComponent.new(drop_arrow: :no, css_class: 'dropdown__button')) do |component| %>
  <% component.with(:opener) do %>
    <div class='flex items-center mr-2'>
      <svg-icon name='plus' feather='true' width='20' height='20'></svg-icon>
      <span class='drop__arrow ml-1'></span>
    </div>
  <% end %>

  <% component.with(:body) do %>
    <% Current.user.publications.includes(:owner).limit(5).order(:id).each do |publication| %>
      <div class='dropdown__item'>
        <% if publication.personal %>
          <%= render(AvatarComponent.new(avatar_url: publication.owner.avatar_url, gravatar_url: publication.owner.gravatar_url, type: :xs)) %>
        <% else %>
          <%= render(AvatarComponent.new(avatar_url: publication.avatar_url, type: :xs)) %>
        <% end %>

        <%= link_to 'Write post', new_publication_post_path(publication), class: "link link--default", role: "menuitem", tabindex: "-1" %>
      </div>
    <% end %>

    <%= link_to 'New publication'.html_safe, new_publication_path, class: "link link--default dropdown__item", role: "menuitem", tabindex: "-1" %>
  <% end %>
<% end %>
