<%= render(DropdownComponent.new(drop_arrow: :no, css_class: 'dropdown__button')) do |component| %>
  <% component.with(:opener) do %>
    <%= content_tag :div, class: 'button button--fill flex items-center' do %>
      Clone <span class='drop__arrow drop__arrow--white ml-1'></span>
    <% end %>
  <% end %>

  <% component.with(:body) do %>
    <%= content_tag :div, class: 'flex items-center' do %>
      <%= text_field_tag 'repository_path', ssh_path, class: 'input py-2 px-4 w-64', readonly: true, id: 'copy_repository_path' %>
      <div class='bg-grey-lightest p-4'>
        <copy-clipboard data-clipboard-target="#copy_repository_path"></copy-clipboard>
      </div>
    <% end %>
  <% end %>
<% end %>
