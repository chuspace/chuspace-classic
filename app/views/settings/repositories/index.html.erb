<div class="w-1/2 mx-auto mt-16">
  <%= render 'settings/navigation' %>

  <div class="profile" data-controller="profile">
    <div class="page-header my-8">
      <h4>Git repository</h4>
      <p class="mt-2 text-secondary">
        Copy your repository url for offline publishing
      </p>
    </div>

    <div class="form border-t border-grey-lighter">
      <div class='flex items-center justify-center py-12'>
        <%= text_field_tag 'repository_path', @user.repository.ssh_path, class: 'input border py-2 px-4 rounded border-grey mr-2 w-1/2', readonly: true, id: 'copy_repository_path' %>
        <copy-clipboard data-clipboard-target="#copy_repository_path"></copy-clipboard>
      </div>
    </div>
  </div>
</div>
