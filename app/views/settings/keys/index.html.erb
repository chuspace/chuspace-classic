<section class="flex">
  <%= render 'settings/navigation' %>

  <div class='container'>
    <%= render 'settings/header', title: 'Ssh keys', description: 'All ssh keys added to your account' do %>
      <%= link_to 'Add new key', new_settings_key_path, class: 'button button--active inline-block sm:block' %>
    <% end %>

    <div class="list border-t border-grey-lighter">
      <% if @user.keys.any? %>
        <%= render partial: 'key', collection: @user.keys %>
      <% else %>
        <h3 class='text-secondary text-center mt-8'>No ssh keys added</h3>
      <% end %>
    </div>
  </div>
</section>
