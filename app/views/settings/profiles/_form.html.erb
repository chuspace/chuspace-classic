<%= simple_form_for @user, remote: true do |f| %>
  <div class='block sm:flex pt-4'>
    <div class='relative w-full sm:w-1/3'>
      <drop-image>
        <div class='avatar__uploader'>
          <% if @user.avatar %>
            <%= render(AvatarComponent.new(avatar_url: @user.avatar_url(variant: :thumb), type: :thumb, options: { id: 'drop_preview' }))  %>
          <% else %>
            <img class='avatar avatar--thumb' id= 'drop_preview'>
          <% end %>
        </div>

        <% if @user.errors.include?(:avatar) %>
          <%= content_tag :span, @user.errors.full_messages_for(:avatar).to_sentence, class: 'input__error text-red block' %>
        <% else %>
          <span class="input__hint avatar__uploader__hint">
            <%= t('.avatar_hint') %>
          </span>
        <% end %>

        <%= f.input(:avatar,
            as: :file,
            wrapper: false,
            label: false,
            input_html: { accept: "image/*", id: 'drop_input' }
          )
        %>
      </drop-image>
    </div>

    <div class='form w-full sm:w-2/3'>
      <%= f.input :name, placeholder: 'Your name', autofocus: true %>
      <%= f.input :bio, placeholder: 'Bio', input_html: { data: { gramm: false } } %>
      <%= f.input :url, placeholder: 'Website' %>
      <%= f.input :location, placeholder: 'Location' %>
      <%= f.input :company, placeholder: 'Company' %>

      <div class='float-left mt-8'>
        <%= f.submit 'Save', class: 'button button--fill  mr-2 ' %>
        <%= link_to 'Cancel', user_path(@user), class: 'button button--default inline-block' %>
      </div>

      <div class='float-right mt-8'>
        <% if Current.user.present? && allowed_to?(:destroy?, @user) %>
          <%= link_to 'Delete account',  user_path(@user), class: 'button button--danger inline-block mr-2', method: :delete, remote: true, data: { confirm: 'This will remove your account and purge all the associated data. Are you sure?' } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
