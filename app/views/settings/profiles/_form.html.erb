<%= simple_form_for @user, remote: true do |f| %>
  <div class='block sm:flex pt-4'>
    <div class='avatar relative w-full sm:w-1/3'>
      <drop-image
        class='avatar__uploader'
        url='<%= @user.avatar_url(variant: :thumb) %>'
        hint='<%= t('.avatar_hint') %>'
        param='user[avatar]'
      >
        <%= component 'avatar', avatar_url: @user.avatar_url(variant: :thumb), variant: :thumb unless @user.avatar.blank?  %>
        <span class="input__hint avatar__uploader__hint <%= @user.avatar.blank? ? 'avatar__uploader__hint__blank' : '' %>">
          <%= t('.avatar_hint') %>
        </span>
        <%= f.input(:avatar,
            as: :file,
            wrapper: false,
            label: false,
            input_html: { accept: "image/*" }
          )
        %>
      </drop-image>
    </div>

    <div class='form w-full sm:w-2/3'>
      <%= f.input :name, placeholder: 'Your name', autofocus: true %>
      <%= f.input :bio, placeholder: 'Bio', input_html: { data: { gramm: false } } %>
      <%= f.input :url, placeholder: 'Website' %>
      <%= f.input :location, placeholder: 'Location' %>
      <%= f.input :company, placeholder: 'Company' %>
    </div>
  </div>

  <div class='float-right mt-8'>
    <%= f.submit 'Submit', class: 'button button--fill  mr-2 ' %>
    <%= link_to 'Cancel', user_path(@user), class: 'button button--default inline-block' %>
  </div>
<% end %>
