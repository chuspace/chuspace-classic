<%= simple_form_for @user, remote: true do |f| %>
  <div class='flex'>
    <div class='avatar w-1/3 mt-8'>
      <%= component 'avatar', avatar: @user.avatar, initials: @user.initials, variant: :sm, css_class: 'mx-auto' %>
      <%= f.input :avatar, as: :file, label: false, placeholder: 'Upload avatar' %>
    </div>

    <div class='form w-2/3'>
      <%= f.input :name, placeholder: 'Your name' %>
      <%= f.input :bio, placeholder: 'Bio', input_html: { data: { gramm: false } } %>
      <%= f.input :url, placeholder: 'Website' %>
      <%= f.input :location, placeholder: 'Location' %>
      <%= f.input :company, placeholder: 'Company' %>
    </div>
  </div>

  <%= f.submit('Submit', class: 'button button--active mt-8 float-right') %>
<% end %>
