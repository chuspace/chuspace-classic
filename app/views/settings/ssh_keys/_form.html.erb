<%= simple_form_for @key, url: settings_ssh_keys_path, remote: true do |f| %>
  <%= f.input :title, placeholder: 'Memorable name', autofocus: true %>
  <%= f.input :key, placeholder: 'Key', input_html: { rows: 4, data: { gramm: false } } %>

  <%= f.submit('Submit', class: 'button mt-4', data: { target: 'ssh-keys.submit' },) %>
<% end %>
