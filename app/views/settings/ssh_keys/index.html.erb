<div class="w-1/2 mx-auto mt-16">
  <%= render 'settings/navigation' %>

  <div class="ssh">
    <div class="my-8 flex justify-between items-center">
      <div class="header">
        <h4>Ssh keys</h4>
        <p class="mt-2 text-secondary">
          All ssh keys added to your account
        </p>
      </div>
      <div>
        <%= link_to 'Add new key', new_settings_ssh_key_path, class: 'button button--active block' %>
      </div>
    </div>

    <div class="mt-16 list">
      <% if @user.ssh_keys.any? %>
        <%= render partial: 'ssh_key', collection: @user.ssh_keys %>
      <% else %>
        <h3 class='text-secondary text-center mt-8'>No ssh keys added</h3>
      <% end %>
    </div>
  </div>
</div>
