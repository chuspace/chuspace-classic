<div class="list-item list-item-flex list-item-bordered">
  <strong class="mr-4 flex-1"><%= key.name %></strong>
  <%= link_to(
      'Delete',
      settings_ssh_key_path(key),
      class: 'btn btn-bordered btn-bordered-red',
      method: :delete,
      remote: true,
      data: { confirm: 'Are you sure?' }
    )
  %>
  <code class="w-full"><%= key.fingerprint %></code>
</div>
