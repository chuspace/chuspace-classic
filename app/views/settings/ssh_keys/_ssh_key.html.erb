<div class="list__item list__item--flex list__item--bordered">
  <div>
    <strong><%= ssh_key.title %></strong>
    <small class="block mt-2">
      Added <%= ssh_key.created_at.to_formatted_s(:long) %>
    </small>
    <small><%= ssh_key.last_used ? "Last used #{distance_of_time_in_words_to_now(ssh_key.last_used)} ago" : 'Never used'  %></small>
  </div>
  <code class='break-all'><%= ssh_key.fingerprint %></code>
  <%= link_to(
    'Delete',
    settings_ssh_key_path(ssh_key),
    method: :delete,
    remote: true,
    class: 'link link--danger underline text-sm',
    data: { confirm: 'Are you sure?' }
  )
  %>
</div>
