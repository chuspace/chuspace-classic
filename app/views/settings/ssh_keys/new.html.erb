<div class="w-1/2 mx-auto mt-16">
  <%= render 'settings/navigation' %>

  <div class="ssh" data-controller="ssh-keys">
    <div class="page-header my-8">
      <h4>Ssh keys</h4>
      <p class="mt-2 text-secondary">
        Add a new ssh key
      </p>
    </div>

    <div class="form">
      <%= render 'form', user: @user %>
      <div class="alert alert-success" data-target='ssh-keys.formSuccess'></div>
    </div>
  </div>
</div>
