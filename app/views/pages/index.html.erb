<div class='container mx-auto mt-32 flex items-center justify-between'>
  <div class='home--banner w-1/2 pr-8'>
    <h1>Collaborative blogging platform built on Git</h1>
    <p class="mt-6 text-lg text-secondary">
      Chuspace is a collaborative blogging platform built on top
      of Git for technical writing.
    </p>
  </div>

  <div class='home--invite-form w-1/3'>
    <h5 class="text-lg text-secondary font-normal">
      Enter your email to get invite for preview version
    </h5>

    <%= simple_form_for @invite, html: { class: 'mt-4' }, remote: true do |f| %>
      <input-check url="<%= check_invite_email_path %>">
        <%= component(
          'input',
          type: :email,
          name: :email,
          form: f,
          css_class: 'mt-2',
          placeholder: 'john@doe.com',
          options: { autocomplete: 'off', spellcheck: 'off', hint: t('invite.attributes.email.help_text') }
        )
        %>
      </input-check>

      <%= f.submit 'Get Started', class: 'button button--active mt-2' %>
    <% end %>
  </div>
</div>
