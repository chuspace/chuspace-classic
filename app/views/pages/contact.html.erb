<% title 'Contact us' %>
<% description 'Contact us via email and we would be happy to help' %>

<div class='mt-32'>
  <h1 class='border-b-2 border-blue-darker inline-block'>Get in touch</h1>
  <h2 class='summary mt-4'>Drop us a note and we will be happy to help 😊</h2>
  <article class='horizontal__list mt-4'>
    <li>
      <svg-icon name='mail' feather='true' class='mr-1' className='inline'></svg-icon> <span>hello@chuspace.com</span>
    </li>
    <li>
      <svg-icon name='twitter' feather='true' class='mr-1' className='inline'></svg-icon> <%= link_to '@chuspace', 'https://twitter.com/chuspace_com', class: 'link link--default', target: '_blank', rel: 'noopener noreferrer' %>
    </li>
    <li>
      <svg-icon name='github' feather='true' class='mr-1' className='inline'></svg-icon> <%= link_to 'GitHub', 'https://github.com/chuspace/platform', class: 'link link--default', target: '_blank', rel: 'noopener noreferrer' %>
    </li>
  </article>
</div>
