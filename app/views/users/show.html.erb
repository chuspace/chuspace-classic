<div class='container mx-auto'>
  <div class='sidebar mb5 flex items-center'>
    <div class='flex'>
     <%= avatar_for(Current.user, size: 'sm') %>
    </div>

    <div class='personal pl-4 w-75'>
      <h1 class='f4 lh-solid mb0 black-80'><%= @user.name %></h1>
      <p class='lh-copy mv1 gray f5'><%= @user.company %></p>
      <p class='lh-copy mt1 black-70 mb0'><%= @user.bio %></p>
    </div>

    <div class='actions'>
      <%= button_tag('Follow', type: 'submit', class: "btn btn-bordered btn-bordered-green") %>
    </div>
  </div>

  <div class='posts'>
    <%= render 'posts/list' %>
  </div>
</div>
