<div class='w-1/2 mx-auto mt-12'>
  <div class='sidebar flex justify-between items-center mb-5'>
   <%= component 'avatar', avatar: @user.avatar, initials: @user.initials, variant: :xl %>

    <div class='useral flex-1 pl-4 w-75'>
      <h3 class='f4 lh-solid mb0 black-80'><%= @user.name %></h3>
      <p class='lh-copy mv1 gray f5'><%= @user.company %></p>
      <p class='lh-copy mt1 black-70 mb0'><%= @user.bio %></p>
    </div>
  </div>

  <div class='posts'>
    <%= render 'posts/list' %>
  </div>
</div>
