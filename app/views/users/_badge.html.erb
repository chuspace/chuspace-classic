<%= link_to user_path(user) do %>
  <div class='author mx-auto text-center'>
    <%= component 'avatar',
      avatar: user.avatar,
      initials: user.initials,
      variant: :md,
      css_class: user.avatar ? 'block mx-auto' : nil
    %>

    <h3 class='text-base mt-4'><%= user.name %></h3>
    <%= content_tag :p, user.bio, class: 'text-grey text-sm w-4/5 mx-auto' unless user.bio.blank? %>
  </div>
<% end %>
