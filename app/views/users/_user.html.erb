<div class='list__item list__item--flex list__item--bordered'>
  <%= link_to user_path(user), class: 'flex items-center' do %>
    <%= render(AvatarComponent.new(avatar_url: user.avatar_url(variant: :md), gravatar_url: user.gravatar_url(variant: :md), type: :md)) %>
    <div class='ml-4 flex-1'>
      <h6>
        <%= user.name %>
        <% if defined?(badge) %>
          <span class='badge badge--grey font-normal'>
            <%= badge %>
          </span>
        <% end %>
      </h6>
      <%= content_tag :p, user.bio, class: 'text-grey text-sm mt-1' %>
    </div>
  <% end %>

  <%= yield %>
</div>
