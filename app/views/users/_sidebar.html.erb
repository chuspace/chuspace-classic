<aside class='mb-5 w-full text-center sm:text-left sm:w-1/3'>
  <%= component(
    'avatar',
    avatar: @user.avatar,
    gravatar: @user.gravatar,
    variant: :profile,
    css_class: 'mx-auto sm:mx-0',
    options: { title: @user.name, alt: @user.name }
  )
  %>

  <div>
    <h3 class='text-2xl mt-8'><%= @user.name %></h3>
    <h3 class='text-base font-normal text-grey'><%= @user.nickname %></h3>
    <%= content_tag :p, @user.bio, class: 'mt-2 text-sm w-3/4' unless @user.bio.blank? %>
    <%= link_to 'Edit profile', settings_profiles_path, class: 'button button--active inline-block mt-4' if Current.user && allowed_to?(:edit?, @user) %>

    <ul class='mt-4 text-sm'>
      <% if @user.company %>
        <%= content_tag :li, class: 'flex items-center' do  %>
          <svg-icon name='users' feather='true' width='15' height='15' class='text-grey mr-2'></svg-icon>
          <%= @user.company %>
        <% end %>
      <% end %>

      <% if @user.location %>
        <%= content_tag :li, class: 'flex items-center' do  %>
          <svg-icon name='map-pin' feather='true' width='15' height='15' class='text-grey mr-2'></svg-icon>
          <%= @user.location %>
        <% end %>
      <% end %>

        <% if @user.url %>
        <%= content_tag :li, class: 'flex items-center' do  %>
          <svg-icon name='link' feather='true' width='15' height='15' class='text-grey mr-2'></svg-icon>
          <%= link_to @user.url, @user.url, class: 'link link--default' %>
        <% end %>
      <% end %>
    </ul>
  </div>

  <div class='flex items-center mt-4' role='img' aria-label='List of <%= @user.name %> publications'>
    <% @user.publications.listed.each do |publication| %>
      <%= link_to publication_path(publication) do %>
        <%= component 'avatar', avatar: publication.avatar, variant: :sm, css_class: 'mr-2', options: { title: publication.name, alt: publication.name } %>
      <% end %>
    <% end %>
  </div>
</aside>
