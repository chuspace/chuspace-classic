<div class='right-nav flex items-center'>
  <div class='mr-2 mt-2'>
    <%= render 'shared/compose_button' %>
  </div>

  <%= component 'dropdown', flush: true, items: nav_items do |d| %>
    <% d.opener do %>
      <%= component('avatar', avatar_url: Current.user.avatar_url, gravatar_url: Current.user.gravatar_url, variant: :xs) %>
    <% end %>
  <% end %>
</div>
