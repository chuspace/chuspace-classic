<div class='right-nav flex items-center'>
  <% if (params[:controller] != 'posts' && params[:controller] != 'posts/publish') %>
    <div class='mr-8'>
      <% if Current.user.publications.size > 1 %>
        <%= render 'shared/compose_button' %>
      <% else %>
        <%= link_to 'Write post', new_publication_post_path(Current.user.publication), class: 'button button--default flex items-center'%>
      <% end %>
    </div>
  <% end %>

  <%= component 'dropdown', flush: true, items: nav_items do |d| %>
    <% d.opener do %>
      <%= component('avatar', avatar: Current.user.avatar, gravatar: Current.user.gravatar, variant: :sm) %>
    <% end %>
  <% end %>
</div>
