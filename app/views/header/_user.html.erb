<div class='right-nav flex items-center'>
  <div data-controller="dropdown">
    <%= octicon "kebab-horizontal", height: 32, class: 'mr-12', 'data-target': "dropdown.opener" %>
    <div data-target="dropdown.content" class="hidden">
      <ul class='list-reset dropdown'>
        <li class='pb-2'>
          <%= link_to('Publish', '#', class: 'link link-default db mb2 text-base text-grey') %>
        </li>

        <li class='pb-2'>
          <%= link_to('Delete', '#', class: 'link link-default db mb2 text-base text-grey') %>
        </li>
      </ul>
    </div>
  </div>

  <%= component 'dropdown', flush: true, items: nav_items do |d| %>
    <% d.opener do %>
      <%= component 'avatar', avatar: Current.user.avatar, initials: Current.user.initials, variant: :xs %>
    <% end %>
  <% end %>
</div>
