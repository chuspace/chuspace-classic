<div data-controller="dropdown">
  <%= content_tag :div, class: 'flex justify-between' do %>
    <%= image_tag(url_for(Current.user.avatar.variant(resize_to_fit: [50, 50])),
      class: "user-nav-avatar", data: { target: "dropdown.opener" })
    %>

    <div data-target="dropdown.content" class="hidden">
      <ul class='list-reset dropdown'>
        <li class='pb-2'>
          <%= link_to('Profile', profile_path(Current.user), class: 'link-gray db mb2 no-underline') %>
        </li>
        <li>
          <%= link_to('Sign out', logout_path, method: :patch, class: 'link-gray no-underline') %>
        </li>
      </ul>
    </div>
  <% end %>
</div>
