<div class='menu'>
  <ul>
    <li><%= link_to 'Write post', new_post_path %></li>
  </ul>
</div>
<%= render "components/dropdown" do %>
  <% content_for :target do %>
    <%= avatar_for(person: Current.person, size: :xs) %>
  <% end %>

  <% content_for :content do %>
    <ul class='list-reset dropdown'>
      <li class='pb-2'>
        <%= link_to('Profile', profile_path(Current.person), class: 'link link-default db mb2') %>
      </li>
      <li class='pb-2'>
        <%= link_to('Settings', settings_path, class: 'link link-default db mb2') %>
      </li>
      <li>
        <%= link_to('Sign out', session_path(Current.person), method: :delete, class: 'link link-default') %>
      </li>
    </ul>
  <% end %>
<% end %>
