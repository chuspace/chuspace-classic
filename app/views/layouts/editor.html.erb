<!DOCTYPE html>
<html>
  <head>
    <title>Chuspace</title>
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application' %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>

  <body class="editor" data-controller="compose popper">
    <div class='container mx-auto'>
      <header>
        <nav class='flex justify-between items-center py-6'>
          <%= component 'logo', type: :badge %>
          <div class='flex-1 ml-4'>
            <%= @blob.author.name %>
          </div>

          <div class='flex justify-end items-center flex-1 mr-4'>
            <div class="mr-4 badge badge--grey">Draft</div>
            <div class="mr-4 badge badge--grey">Saved</div>
            <div class="mr-4 badge badge--grey">4 mins</div>
            <dialog-opener class='link link-default' target='publish-<%= @blob.slug%>'>Publish</dialog-opener>
          </div>

          <% if Current.user.present? %>
            <%= render 'header/user'  %>
          <% else %>
            <%= render 'header/guest'  %>
          <% end %>
        </nav>
      </header>
    </div>

    <section class='w-1/2 mx-auto mt-12 pb-32'>
      <%= yield %>
    </section>
  </body>
</html>
