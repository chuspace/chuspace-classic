<!DOCTYPE html>
<html>
  <head>
    <title>Chuspace</title>
    <%= csrf_meta_tags %>
    <link rel="prefetch" href="<%= asset_pack_path('application.js') %>" as="style" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= javascript_pack_tag 'application', defer: true, 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%= render 'layouts/header' %>

    <div class='content w-1/2 mx-auto'>
      <div class='pt-16'>
        <div class='flex justify-between items-center mb-5'>
          <%= component 'avatar', avatar: @user.avatar, initials: @user.initials, variant: :xl %>

          <div class='flex-1 pl-4 w-75'>
            <h3><%= @user.name %></h3>

            <%= content_tag :p, @user.bio, class: 'text-sm mt-1' if @user.bio %>

            <ul class='horizontal__list text-sm'>
              <%= content_tag :li, @user.company if @user.company %>
              <%= content_tag :li, @user.location if @user.location %>
              <%= content_tag :li do %>
                <%= link_to 'Website', @user.url, class: 'link link--active underline text-sm', target: '_blank', rel: 'noopener noreferer' if @user.url %>
              <% end %>
            </ul>
          </div>

          <%= link_to 'Edit profile', settings_profiles_path, class: 'button button--active inline-block'%>
        </div>

        <div class='posts mt-12'>
          <ul class="list-reset tabs">
            <li class="<%= tabs_class(user_path(@user)) %>">
              <%= link_to 'Published', user_path(@user) %>
            </li>

            <li class="<%= tabs_class(user_drafts_path(@user)) %>">
              <%= link_to 'Drafts', user_drafts_path(@user) %>
            </li>
          </ul>

          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
