<header>
  <nav class='flex justify-between items-center py-6'>
    <%= link_to root_path, class: 'link link-white' do %>
      <div class='logo icon'>C</div>
    <% end %>

    <% if Current.user.present? %>
      <%= render 'header/user'  %>
    <% else %>
      <%= render 'header/guest'  %>
    <% end %>
  </nav>
</header>
