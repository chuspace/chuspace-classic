<header <%= "data-controller=headroom" if @headroom %>>
  <nav class='container flex justify-between items-center py-2'>
    <%= render(LogoComponent.new(type: Current.user.present? ? :badge : :full)) %>

    <% if params[:controller] == 'posts' %>
      <%= render "posts/header/#{params[:action]}", post: @post, publication: @publication %>
    <% end %>

    <%= render "header/#{Current.user.present? ? 'user' : 'guest'}"  %>
  </nav>
</header>
