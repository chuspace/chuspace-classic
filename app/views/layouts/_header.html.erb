<header class='mw8'>
  <nav class='flex justify-between py-6'>
    <div class='logo f2 avenir b db'>
      <%= link_to 'chuspace', root_path, class: 'link link-default text-3xl' %>
    </div>

    <% if Current.user.present? %>
      <%= render 'header/user'  %>
    <% else %>
      <%= render 'header/guest'  %>
    <% end %>
  </nav>
</header>
