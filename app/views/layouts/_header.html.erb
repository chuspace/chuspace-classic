<header>
  <nav class='flex justify-between items-center py-6'>
    <div class='logo icon'>
      <%= link_to 'C', root_path, class: 'link link-white' %>
    </div>

    <% if Current.person.present? %>
      <%= render 'header/person'  %>
    <% else %>
      <%= render 'header/guest'  %>
    <% end %>
  </nav>
</header>
