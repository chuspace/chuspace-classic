<header <%= "data-controller=headroom" if params[:controller] == 'posts' %>>
  <nav class='container flex justify-between items-center py-2'>
    <%= component 'logo', type: Current.user.present? ? :badge : :full %>
    <% if params[:controller] == 'posts' || params[:controller] == 'posts/publish' %>
      <%= post_header(@post) %>
    <% end %>
    <%= render "header/#{Current.user.present? ? 'user' : 'guest'}"  %>
  </nav>
</header>
