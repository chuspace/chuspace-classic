<header class='header'>
  <nav class='nav pv3 flex justify-between items-center'>
    <div class='logo f3 b db'>
      <%= link_to 'Chuspace', root_path, class: 'logo-link no-underline black-90' %>
    </div>

    <% if Current.user.present? %>
      <%= react_component 'header/user', { name: Current.user.name, avatar: url_for(Current.user.avatar), logout_path: logout_path }, { prerender: true }  %>
    <% else %>
      <%= react_component 'header/guest', { registrations_path: users_path, login_path: login_path, check_nicknames_path: check_nicknames_path }, { prerender: true } %>
    <% end %>
  </nav>
</header>
