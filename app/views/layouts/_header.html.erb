<header>
  <nav class='flex justify-between py-6'>
    <div class='logo font-sans text-4xl'>
      <%= link_to 'chuspace', root_path, class: 'link link-default' %>
    </div>

    <% if Current.user.present? %>
      <%= render 'header/user'  %>
    <% else %>
      <%= render 'header/guest'  %>
    <% end %>
  </nav>
</header>
