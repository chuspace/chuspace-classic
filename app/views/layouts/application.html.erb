<!DOCTYPE html>
<html lang='en' class='flex-body'>
  <%= render 'layouts/head' %>
  <body class="flex-body" data-controller='popper'>
    <% flash.each do |key, value| %>
      <alert-notification
        level='<%= key %>'
        message='<%= value %>'
        class="alert-container animated fast fadeInDown">
      </alert-notification>
    <% end %>

    <%= render 'layouts/header' %>

    <section class="container content mx-auto">
      <div class='mt-12'>
        <%= yield %>
      </div>
    </section>

    <div class='container mx-auto'>
      <%= render 'layouts/footer' %>
    </div>
  </body>
</html>
