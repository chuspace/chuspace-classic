<!DOCTYPE html>
<html class='flex-body'>
  <head>
    <title>Chuspace</title>
    <%= csrf_meta_tags %>
    <%= javascript_pack_tag 'application' %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>

  <body class="application flex-body" data-controller='popper'>
    <div class='container mx-auto'>
      <%= render 'layouts/header' %>
    </div>

    <section class="content">
      <%= yield %>
    </section>

    <div class='container mx-auto'>
      <%= render 'layouts/footer' %>
    </div>

    <div class="animated alert-container fast bounceInRight" data-controller="alerts">
      <% flash.each do |key, value| %>
        <div class="<%= flash_message_class(key) %>">
          <div class="p-4 ">
            <%= value %>
          </div>
        </div>
      <% end %>
    </div>

    <%= javascript_pack_tag 'custom-elements' %>
    <script>
      (function(w, d){
      var id='embedly-platform', n = 'script';
      if (!d.getElementById(id)){
        w.embedly = w.embedly || function() {(w.embedly.q = w.embedly.q || []).push(arguments);};
        var e = d.createElement(n); e.id = id; e.async=1;
        e.src = ('https:' === document.location.protocol ? 'https' : 'http') + '://cdn.embedly.com/widgets/platform.js';
        var s = d.getElementsByTagName(n)[0];
        s.parentNode.insertBefore(e, s);
      }
      })(window, document);
    </script>
  </body>
</html>
