<!DOCTYPE html>
<html class='flex-body'>
  <head>
    <title>Chuspace</title>
    <%= csrf_meta_tags %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/diff_match_patch/20121119/diff_match_patch.js"></script>
    <link rel="prefetch" href="<%= asset_pack_path('application.js') %>" as="style" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= javascript_pack_tag 'application', defer: true, 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
  </head>
  <body class="flex-body" data-controller='popper'>
    <% flash.each do |key, value| %>
      <alert-notification
        level='<%= key %>'
        message='<%= value %>'
        class="alert-container animated fast fadeInDown">
      </alert-notification>
    <% end %>

    <%= render 'layouts/header' %>

    <section class="content">
      <%= yield %>
    </section>

    <div class='container mx-auto'>
      <%= render 'layouts/footer' %>
    </div>
  </body>
</html>
