<!DOCTYPE html>

<html lang='en' class='flex-body'>
  <%= render 'layouts/head' %>
  <body class="flex-body" data-controller='popper'>
    <% flash.each do |key, value| %>
      <alert-notification
        level='<%= key %>'
        message='<%= value %>'
        class="alert-container animated fast fadeInDown">
      </alert-notification>
    <% end %>

    <%= render 'layouts/header' %>

    <section class="container content <%= layout_class %>">
      <%= yield %>
    </section>

    <% unless params[:controller].include?('posts') %>
      <div class='container'>
        <%= render 'layouts/footer' %>
      </div>
    <% end %>
  </body>
</html>
