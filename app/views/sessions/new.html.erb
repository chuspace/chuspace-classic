<div data-controller='login' class='centered'>
  <div data-target='login.actionsCard' class='card card-center card-login'>
    <h2 class='card-title'>Welcome back</h2>

    <p class='card-intro'>
      Sign in to access your personalized homepage, follow authors and topics
      you love, and clap for stories that matter to you.
    </p>

    <div class='card-body'>
      <%= link_to('Sign in with github', '/auth/github', class: 'btn btn-bordered btn-bordered-green mb-2 block max-w-xxs mx-auto') %>
      <%= link_to('Sign in with email', '#', class: 'btn btn-bordered btn-bordered-green block max-w-xxs mx-auto', 'data-action': 'click->login#toggleForm') %>
    </div>

    <p class='card-footer'>
      No account? <%= link_to('Join', new_registration_path, class: 'link link-green') %>
    </p>
  </div>

  <div data-target='login.formCard' class='card card-center card-login hidden'>
    <h2 class='card-title'>Sign in with email</h2>

    <p class='card-intro'>
      Enter the email address associated with your account, and we’ll send a
      magic link to your inbox.
    </p>

    <div class='card-body'>
      <%= form_with url: sessions_path, data: { target: 'login.form', action: 'ajax:success->login#onLoginSuccess' } do |form| %>
        <%= form.text_field(
          'email',
          autocomplete: 'email',
          placeholder: 'Enter email',
          autofocus: true,
          'data-target': 'login.inputEmail',
          class: 'input input-bordered input-bordered-green block mx-auto mb-2'
        ) %>
        <span class="alert alert-error" data-target='login.inputEmailError'></span>
        <%= form.submit 'Submit', class: 'btn btn-black mt-4' %>
      <% end %>

      <span class="alert alert-success" data-target='login.formSuccess'></span>
    </div>

    <div class='card-footer'>
      <%= link_to('← Go back', '#', class: 'link link-default', 'data-action': 'click->login#toggleActions') %>
    </div>
  </div>
</div>
