<div class='login-form'>
  <h2 class='f2 lh-title'>Sign in with email</h2>
  <p class='intro f5 lh-copy'>
    Enter the email address associated with your account, and we’ll send a
    magic link to your inbox.
  </p>

  <%= form_tag, class: 'form measure center w-60' %>
    <%= text_field_tag(
      'email',
      autocomplete: 'email'
      placeholder: 'Enter email'
      autofocus: true
      class: class_for(:input, type: :green, additional: 'db w-100')
    ) %>

    <%= submit_tag(
        'Submit',
        class: class_for(:button, type: :bg_black, additional: 'w-100 db mw5 mt3')
      )
    %>
  <% end %>

  <a
    class='black-90 center mt3 db no-underline f6 lh-copy'
    href='#'
  >
    ← Go back
  </a>
</div>
