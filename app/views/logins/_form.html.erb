<div class='login-form'>
  <h2 class='f2 lh-title'>Sign in with email</h2>
  <p class='intro f5 lh-copy'>
    Enter the email address associated with your account, and we’ll send a
    magic link to your inbox.
  </p>

  <%= form_tag, class: 'form measure center w-60' %>
    <%= text_field_tag(
      'email',
      autocomplete: 'email'
      placeholder: 'Enter email'
      autofocus: true
      class: 'valid-input db w-100'
    ) %>

    <%= submit_tag('Submit', class: 'black-bg-btn w-100 db mw5 mt3') %>
  <% end %>
  <%= link_to('← Go back', '#', class: 'primary-link center mt3 db') %>
</div>
