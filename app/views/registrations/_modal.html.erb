<%= render "components/modal", options: { 'data-target': 'auth.registerActions', class: 'dialog-green' } do %>
  <%= content_for :header, flush: true do %>
    <h2>Join Chuspace</h2>
  <% end %>

  <%= content_for :intro, flush: true do %>
    <p>
      Create an account to personalize your homepage, follow your favorite
      authors and publications, applaud stories you love, and more.
    </p>
  <% end %>

  <%= content_for :body, flush: true do %>
    <%= link_to('Sign up with github', '/auth/github', class: 'btn btn-bordered btn-bordered-green mb-2 block max-w-xxs mx-auto') %>
    <%= link_to('Sign up with email', '#', class: 'btn btn-bordered btn-bordered-green block max-w-xxs mx-auto', 'data-action': 'click->auth#showRegisterForm') %>
  <% end %>

  <%= content_for :footer, flush: true do %>
    <p>
      Already have an account?
      <%= link_to('Sign in', '#', class: 'green-link', 'data-action': 'click->auth#showLoginActions') %>
    </p>
  <% end %>
<% end %>

<%= render "components/modal", options: { 'data-target': 'auth.registerForm', class: 'dialog-green' } do %>
  <%= content_for :header, flush: true do %>
    <h2>Sign up with email</h2>
  <% end %>

  <%= content_for :intro, flush: true do %>
    <p>
      Enter the email address associated with your account, and we’ll send a
      magic link to your inbox.
    </p>
  <% end %>

  <%= content_for :body, flush: true do %>
    <%= form_tag '/foo', class: 'form measure center w-60' do %>
      <%= text_field_tag(
        'name',
        nil,
        autocomplete: 'name',
        placeholder: 'Full name',
        autofocus: true,
        class: 'input input-bordered input-bordered-green block mx-auto mb-2'
      ) %>

      <%= text_field_tag(
        'nickname',
        nil,
        autocomplete: 'nickname',
        placeholder: 'Username',
        class: 'input input-bordered input-bordered-green block mx-auto mb-2'
      ) %>

      <%= text_field_tag(
        'email',
        nil,
        autocomplete: 'email',
        placeholder: 'Email',
        class: 'input input-bordered input-bordered-green block mx-auto mb-2',
        type: 'email'
      ) %>

      <%= button_tag('Submit', class: 'btn btn-black mt-4') %>
    <% end %>
  <% end %>

  <%= content_for :footer, flush: true do %>
    <%= link_to('← Go back', '#', class: 'link link-default db center', 'data-action': 'click->auth#showRegisterActions') %>
  <% end %>
<% end %>
