<div class='registration-form'>
  <h2 class='f2 lh-title'>Sign up with email</h2>
  <p class='intro f5 lh-copy'>
    Enter the email address associated with your account, and we’ll send a
    magic link to your inbox.
  </p>

   <%= form_tag, class: 'form measure center w-60' do %>
      <%= text_field_tag(
        'name',
        autocomplete: 'name'
        placeholder: 'Full name'
        autofocus: true
        class:"input f6 ba b--light-green pa2 w-100 br2 db mb2 input-reset"
      ) %>

      <%= text_field_tag(
        'nickname',
        autocomplete: 'nickname'
        placeholder: 'Username'
        class:"input f6 ba b--light-green pa2 w-100 br2 db mb2 input-reset"
      ) %>

      <%= text_field_tag(
        'email',
        autocomplete: 'email'
        placeholder: 'Email'
        class:"input f6 ba b--light-green pa2 w-100 br2 db mb2 input-reset"
        type: 'email'
      ) %>

      <%= submit_tag(
          'Submit',
          class: 'pointer ba b--light-green pa2 br2 db mw5 no-underline outline-0 center bg-black white bn mt3'
        )
      %>
    <% end %>

  <a
    class='black-90 center mt3 db no-underline f6 lh-copy'
    href='#'
  >
    ← Go back
  </a>
</div>
