<div class='registration-form'>
  <h2 class='f2 lh-title'>Sign up with email</h2>
  <p class='intro f5 lh-copy'>
    Enter the email address associated with your account, and we’ll send a
    magic link to your inbox.
  </p>

  <%= form_tag, class: 'form measure center w-60' do %>
    <%= text_field_tag(
      'name',
      autocomplete: 'name'
      placeholder: 'Full name'
      autofocus: true
      class: 'primary-input db w-100'
    ) %>

    <%= text_field_tag(
      'nickname',
      autocomplete: 'nickname'
      placeholder: 'Username'
      class: 'primary-input db w-100'
    ) %>

    <%= text_field_tag(
      'email',
      autocomplete: 'email'
      placeholder: 'Email'
      class: 'primary-input db w-100'
      type: 'email'
    ) %>

    <%= submit_tag('Submit', class: 'black-bg-btn w-100 db mw5 mt3') %>
  <% end %>

  <%= link_to ('← Go back', '#', class: 'primary-link db center') %>
</div>
