<div class='registration-actions'>
  <h2 class='f2 lh-title'>Join Chuspace</h2>
  <p class='intro f5 lh-copy'>
    Create an account to personalize your homepage, follow your favorite
    authors and publications, applaud stories you love, and more.
  </p>
  <div class='actions mt4'>
    <%= link_to('Sign up with github', '/auth/github', class: 'ba b--light-green pointer pa2 br2 db mw5 no-underline outline-0 center mb2 bg-white black') %>
    <%= link_to('Sign up with email', '/auth/github', class: 'ba b--light-green pointer pa2 br2 db mw5 no-underline outline-0 center bg-white black') %>
  </div>
  <p class='mt4'>
    Already have an account?
    <%= link_to('Sign in', '/auth/github', class: 'black-90 no-underline pointer dib dark-green bb b--dark-green pb1') %>
  </p>
</div>
