<div data-controller='register' class='centered mt-10'>
  <div class='card max-w-sm text-center'>
    <h2 class='card-title'>Sign up</h2>

    <p class='card-intro'>
      Enter the email address associated with your account, and we’ll send a
      magic link to your inbox.
    </p>

    <div class='card-body'>
      <%= form_with url: registrations_path, scope: :user, data: { target: 'register.form', action: 'ajax:success->register#onFormSubmit' } do |form| %>
        <%= form.text_field(
          'name',
          autocomplete: 'name',
          placeholder: 'Full name',
          autofocus: true,
          data: { target: 'register.inputName' },
          class: 'input input-bordered input-bordered-green block mb-2 mx-auto'
        ) %>

        <span class="alert alert-error mb-2 text-left" data-target='register.inputNameError'></span>

        <%= form.text_field(
          'nickname',
          autocomplete: 'nickname',
          placeholder: 'Nickname',
          data: { target: 'register.inputNickname' },
          class: 'input input-bordered input-bordered-green block mb-2 mx-auto'
        ) %>

        <span class="alert alert-error mb-2 text-left" data-target='register.inputNicknameError'></span>

        <%= form.text_field(
          'email',
          autocomplete: 'email',
          placeholder: 'Email',
          data: { target: 'register.inputEmail' },
          class: 'input input-bordered input-bordered-green block mb-2 mx-auto',
          type: 'email'
        ) %>

        <span class="alert alert-error mb-2 text-left" data-target='register.inputEmailError'></span>

        <%= form.fields_for :default_blog do |blog| %>
           <%= blog.text_field(
            'name',
            autocomplete: false,
            placeholder: 'Blog name',
            data: { target: 'register.inputBlogName' },
            class: 'input input-bordered input-bordered-green block mb-2 mx-auto'
          ) %>

          <span class="alert alert-error mb-2 text-left" data-target='register.inputBlogNameError'></span>
        <% end %>

        <%= form.submit('Submit', class: 'btn btn-black mt-4 mx-auto') %>
      <% end %>

      <div class="alert alert-success" data-target='register.formSuccess'></div>
    </div>

    <div class='card-footer'>
      <%= link_to('← Go back', registrations_path, class: 'link link-default db') %>
    </div>
  </div>
</div>
