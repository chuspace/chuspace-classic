  "scripts": {
    "format": "yarn run prettier --single-quote --no-semi --write '**/*.{js,jsx,rb,rake}'",
    "format:pr": "git diff --name-only --diff-filter=ACMR master..HEAD | grep '**/*.{js,jsx,rb,rake}$' | xargs yarn run prettier --single-quote --no-semi --write",
    "flow-typed-install": "flow-typed install -s -o --libdefDir ./app/javascript/flow-types"
  },
