  },
  "devDependencies": {
    "@prettier/plugin-ruby": "^0.18.1",
    "babel-eslint": "~10.1.0",
    "eslint": "6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-flowtype": "^4.7.0",
