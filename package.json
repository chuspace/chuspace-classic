{
  "name": "chuspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "10.16.3"
  },
  "size-limit": [
    {
      "webpack": false,
      "path": [
        "public/packs/js/application-*.js",
        "public/packs/js/custom-elements-*.js"
      ]
    }
  ],
  "scripts": {
    "format": "yarn run prettier --single-quote --no-semi --write '**/*.{js,jsx,rb,rake}'",
    "format:pr": "git diff --name-only --diff-filter=ACMR master..HEAD | grep '**/*.{js,jsx,rb,rake}$' | xargs yarn run prettier --single-quote --no-semi --write",
    "flow-typed-install": "flow-typed install -s -o --libdefDir ./app/javascript/flow-types",
    "size": "bundle exec rails webpacker:compile && size-limit"
  },
  "dependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-decorators": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.9.0",
    "@babel/preset-flow": "^7.9.0",
    "@babel/runtime": "^7.9.2",
    "@fullhuman/postcss-purgecss": "^2.1.2",
    "@github/auto-complete-element": "^2.0.0",
    "@github/details-menu-element": "^1.0.8",
    "@iframely/embed.js": "^1.3.1",
    "@rails/actioncable": "^6.0.2-2",
    "@rails/webpacker": "^5.0.1",
    "@tarekraafat/autocomplete.js": "^7.2.0",
    "animate.css": "^3.7.2",
    "autosize": "^4.0.2",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-module-resolver": "~4.0.0",
    "babel-plugin-transform-decorators": "^6.24.1",
    "babel-plugin-transform-decorators-legacy": "^1.3.5",
    "caniuse-lite": "~1.0.30001041",
    "classnames": "^2.2.6",
    "clipboard": "^2.0.6",
    "codemirror": "^5.52.2",
    "codemirror-mode-elixir": "^1.1.2",
    "core-js": "^3.6.5",
    "details-element-polyfill": "^2.4.0",
    "dialog-polyfill": "^0.5.1",
    "diff": "^4.0.2",
    "dropzone": "^5.7.0",
    "flow-bin": "^0.122.0",
    "graphql": "15.0.0",
    "graphql-language-service-parser": "^1.5.2",
    "headroom.js": "^0.11.0",
    "highlight.js": "^9.18.1",
    "is-url": "^1.2.4",
    "lazysizes": "^5.2.0",
    "lit-element": "^2.3.1",
    "lit-html": "^1.2.1",
    "lodash": "^4.17.15",
    "lodash-webpack-plugin": "^0.11.5",
    "markdown-it": "^10.0.0",
    "nanoid": "^3.1.3",
    "node-sass-glob-importer": "^5.3.2",
    "normalize.css": "^8.0.1",
    "null-loader": "^3.0.0",
    "postcss-preset-env": "^6.7.0",
    "prosemirror-changeset": "^2.1.2",
    "prosemirror-collab": "^1.2.2",
    "prosemirror-commands": "^1.1.3",
    "prosemirror-dropcursor": "^1.3.2",
