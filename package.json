{
  "name": "chuspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "10.16.0"
  },
  "size-limit": [
    {
      "webpack": false,
      "path": [
        "public/packs/js/application-*.js",
        "public/packs/js/custom-elements-*.js"
      ]
    }
  ],
  "scripts": {
    "format": "yarn run prettier --single-quote --no-semi --write '**/*.{js,jsx,rb,rake}'",
    "format:pr": "git diff --name-only --diff-filter=ACMR master..HEAD | grep '**/*.{js,jsx,rb,rake}$' | xargs yarn run prettier --single-quote --no-semi --write",
    "flow-typed-install": "flow-typed install -s -o --libdefDir ./app/javascript/flow-types",
    "size": "bundle exec rails webpacker:compile && size-limit"
  },
  "dependencies": {
    "@babel/cli": "^7.5.5",
    "@babel/core": "^7.5.5",
    "@babel/plugin-proposal-decorators": "^7.4.4",
    "@babel/plugin-transform-runtime": "^7.5.5",
    "@babel/preset-flow": "^7.0.0",
    "@babel/runtime": "^7.5.5",
    "@fullhuman/postcss-purgecss": "^1.2.0",
    "@github/details-menu-element": "^1.0.3",
    "@iframely/embed.js": "^1.3.0",
    "@manuscripts/prosemirror-recreate-steps": "^0.1.4",
    "@rails/actioncable": "^6.0.0-alpha",
    "@rails/webpacker": "^4.0.7",
    "@tarekraafat/autocomplete.js": "^6.1.0",
    "animate.css": "^3.7.2",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-module-resolver": "~3.2.0",
    "babel-plugin-transform-decorators": "^6.24.1",
    "babel-plugin-transform-decorators-legacy": "^1.3.5",
    "caniuse-lite": "~1.0.30000988",
    "classnames": "^2.2.6",
    "clipboard": "^2.0.4",
    "codemirror": "^5.48.2",
    "codemirror-mode-elixir": "^1.1.2",
    "comlink": "^4.0.2",
    "core-js": "^3.1.4",
    "dialog-polyfill": "^0.5.0",
    "flow-bin": "^0.104.0",
    "graphql": "0.13.0",
    "graphql-language-service-parser": "^1.2.2",
    "highlight.js": "^9.15.9",
    "is-url": "^1.2.4",
    "lazysizes": "^5.1.0",
    "lit-element": "^2.2.1",
    "lit-html": "^1.1.1",
    "lodash": "^4.17.15",
    "lodash-webpack-plugin": "^0.11.5",
    "markdown-it": "^9.0.1",
    "nanoid": "^2.0.3",
    "node-sass-glob-importer": "^5.3.2",
    "normalize.css": "^8.0.1",
    "null-loader": "^3.0.0",
    "postcss-preset-env": "^6.7.0",
    "prosemirror-changeset": "^2.0.4",
    "prosemirror-commands": "^1.0.8",
    "prosemirror-dropcursor": "^1.1.1",
    "prosemirror-gapcursor": "^1.0.4",
    "prosemirror-history": "^1.0.4",
    "prosemirror-inputrules": "^1.0.4",
    "prosemirror-markdown": "^1.3.1",
    "prosemirror-model": "^1.7.1",
    "prosemirror-schema-list": "^1.0.3",
    "prosemirror-state": "^1.2.3",
    "prosemirror-transform": "^1.1.3",
    "prosemirror-view": "^1.9.13",
    "query-string": "^6.8.2",
    "rails-ujs": "^5.2.3",
    "stimulus": "^1.1.1",
    "tailwindcss": "^1.0.6",
    "tippy.js": "^4.3.4",
    "tohash": "^1.0.2",
    "turbolinks": "^5.2.0",
    "webpack": "^4.38.0",
    "webpack-cli": "^3.3.6",
    "whatwg-fetch": "^3.0.0",
    "workbox-webpack-plugin": "^4.3.1",
    "worker-loader": "^2.0.0"
  },
  "devDependencies": {
    "@prettier/plugin-ruby": "^0.14.0",
    "babel-eslint": "~10.0.2",
    "eslint": "6.1.0",
    "eslint-config-prettier": "^6.0.0",
    "eslint-plugin-flowtype": "^3.12.2",
    "eslint-plugin-import": "~2.18.2",
    "eslint-plugin-node": "~9.1.0",
    "eslint-plugin-prettier": "^3.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "flow-typed": "^2.6.1",
    "prettier": "^1.18.2",
    "size-limit": "^1.3.8",
    "webpack-bundle-analyzer": "^3.4.1",
    "webpack-dev-server": "^3.7.2"
  }
}
