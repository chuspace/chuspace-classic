{
  "name": "chuspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "12.18.3"
  },
  "size-limit": [
    {
      "webpack": false,
      "path": [
        "public/packs/js/application-*.js",
        "public/packs/js/custom-elements-*.js"
      ]
    }
  ],
  "scripts": {
    "format": "yarn run prettier --single-quote --no-semi --write '**/*.{js,jsx,rb,rake}'",
    "format:pr": "git diff --name-only --diff-filter=ACMR master..HEAD | grep '**/*.{js,jsx,rb,rake}$' | xargs yarn run prettier --single-quote --no-semi --write",
    "flow-typed-install": "flow-typed install -s -o --libdefDir ./app/javascript/flow-types",
    "size": "bundle exec rails webpacker:compile && size-limit"
  },
  "dependencies": {
    "@babel/cli": "^7.11.6",
    "@babel/core": "^7.11.6",
    "@babel/plugin-proposal-decorators": "^7.10.5",
    "@babel/plugin-transform-runtime": "^7.11.5",
    "@babel/preset-flow": "^7.10.4",
    "@babel/runtime": "^7.11.2",
    "@fullhuman/postcss-purgecss": "^2.3.0",
    "@github/auto-complete-element": "^3.0.2",
    "@github/details-menu-element": "^1.0.9",
    "@iframely/embed.js": "^1.3.1",
    "@rails/actioncable": "^6.0.3-2",
    "@rails/webpacker": "^5.2.1",
    "@tarekraafat/autocomplete.js": "^7.2.0",
    "@toast-ui/toastmark": "^0.0.1-alpha.1",
    "animate.css": "^4.1.1",
    "autosize": "^4.0.2",
    "babel-plugin-lodash": "^3.3.4",
    "babel-plugin-module-resolver": "~4.0.0",
    "babel-plugin-transform-decorators": "^6.24.1",
    "babel-plugin-transform-decorators-legacy": "^1.3.5",
    "caniuse-lite": "~1.0.30001125",
    "classnames": "^2.2.6",
    "clipboard": "^2.0.6",
    "codemirror": "^5.57.0",
    "codemirror-mode-elixir": "^1.1.2",
    "core-js": "^3.6.5",
    "details-element-polyfill": "^2.4.0",
    "dialog-polyfill": "^0.5.3",
    "diff": "^4.0.2",
    "dropzone": "^5.7.2",
    "flow-bin": "^0.133.0",
    "graphql": "15.3.0",
    "graphql-language-service-parser": "^1.6.2",
    "headroom.js": "^0.11.0",
    "highlight.js": "^10.2.0",
    "is-url": "^1.2.4",
    "lazysizes": "^5.2.2",
    "lit-element": "^2.4.0",
    "lit-html": "^1.3.0",
    "lodash": "^4.17.20",
    "lodash-webpack-plugin": "^0.11.5",
    "markdown-it": "^11.0.0",
    "nanoid": "^3.1.12",
    "node-sass-glob-importer": "^5.3.2",
    "normalize.css": "^8.0.1",
    "null-loader": "^4.0.0",
    "postcss-preset-env": "^6.7.0",
    "query-string": "^6.13.1",
    "rails-ujs": "^5.2.4-3",
    "stimulus": "^1.1.1",
    "tailwindcss": "^1.8.5",
    "tippy.js": "6.2.6",
    "tohash": "^1.0.2",
    "tui-code-snippet": "^2.3.2",
    "turbolinks": "^5.2.0",
    "webpack": "^4.44.1",
    "webpack-cli": "^3.3.12",
    "whatwg-fetch": "^3.4.1",
    "workbox-webpack-plugin": "^5.1.3"
  },
  "devDependencies": {
    "@prettier/plugin-ruby": "^0.20.1",
    "babel-eslint": "~10.1.0",
    "eslint": "7.8.1",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-flowtype": "^5.2.0",
    "eslint-plugin-import": "~2.22.0",
    "eslint-plugin-node": "~11.1.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-promise": "^4.2.1",
    "flow-typed": "^3.2.1",
    "prettier": "^2.1.1",
    "size-limit": "^4.6.0",
    "webpack-bundle-analyzer": "^3.8.0",
    "webpack-dev-server": "^3.11.0"
  }
}
