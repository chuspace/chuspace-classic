chuspace: bundle exec rails s --early-hints
webpacker: dotenv -f ".env.development" ./bin/webpack --watch --progress --color
imgproxy: dotenv -f ".env.development" imgproxy
anycable-go: anycable-go --headers=cookie,origin --host=0.0.0.0 --port=3334
anycable: dotenv -f ".env.development" bundle exec anycable
jobs: bundle exec rake jobs:work
