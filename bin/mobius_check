#!/usr/bin/env ruby

require_relative '../app/lib/mobius'
require File.join(Mobius::ROOT_PATH, 'net')

print "Check GitLab API access: "
begin
  resp = Mobius::Net.new.check
  if resp.code == "200"
    print 'OK'
  else
    abort "FAILED. code: #{resp.code}"
  end
rescue Mobius::Net::ApiUnreachableError
  abort "FAILED: Failed to connect to internal API"
end

abort("ERROR: missing option in config.yml") unless Mobius.config.ssh_auth_file

print "\nAccess to #{config.ssh_auth_file}: "

if system(File.dirname(__FILE__) + '/mobius_keys', 'check-permissions')
  print 'OK'
else
  abort "FAILED"
end
puts "\n"
