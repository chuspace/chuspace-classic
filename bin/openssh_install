#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require_relative '../app/lib/git'

commands = []
commands << %W(mkdir -p #{Git.config.storage_path})
commands << %W(chmod ug+rwX,o-rwx #{Git.config.storage_path})

commands.each do |cmd|
  print "#{cmd.join(' ')}: "
  if system(*cmd)
    puts 'OK'
  else
    puts 'Failed'
    abort "#{$PROGRAM_NAME} failed"
  end
end

exit
