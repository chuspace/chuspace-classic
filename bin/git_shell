#!/Users/gaurav/.rbenv/shims/ruby
# frozen_string_literal: true

unless ENV['SSH_CONNECTION']
  puts 'Only ssh allowed'
  exit
end

require_relative '../app/lib/git/config'
require_relative '../app/lib/git/shell'

key_id = /key-[0-9]+/.match(ARGV.join).to_s
original_cmd = ENV.delete('SSH_ORIGINAL_COMMAND')

require File.join(Git::Config::ROOT_PATH, 'shell')

if Git::Shell.new(key_id).exec(original_cmd)
  exit 0
else
  exit 1
end
