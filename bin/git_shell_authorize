#!/Users/gaurav/.rbenv/shims/ruby
# frozen_string_literal: true

#
# GitLab shell authorized_keys helper. Query GitLab API to get the authorized
# command for a given ssh key fingerprint
#
# Ex.
#   bin/git_shell_authorize <username> <public-key>
#
# Returns
#   command="/bin/git_shell key-#",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-rsa AAAA...
#
# Expects to be called by the SSH daemon, via configuration like:
#     AuthorizedKeysCommandUser git
#     AuthorizedKeysCommand /bin/git_shell_authorize git %u %k


key = ARGV[1]

abort '# No key provided' if key.nil? || key == ''

require_relative '../app/lib/git/ssh_key'
puts Git::SshKey.new(key).command
