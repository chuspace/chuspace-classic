#!/usr/bin/env ruby

require_relative '../app/lib/mobius/init'
require File.join(MOBIUS_ROOT, 'metrics')
require File.join(MOBIUS_ROOT, 'projects')

repository_storage_paths = ARGV

repository_storage_paths.each do |repo_path|
  Dir["#{repo_path.chomp('/')}/*/*.git"].each do |repo|
    begin
      Mobius::Metrics.measure('command-create-hooks') do
        Mobius::Projects.create_hooks(repo)
      end
    rescue Errno::ENOENT
      # The user must have deleted their repository. Ignore.
    end
  end
end
