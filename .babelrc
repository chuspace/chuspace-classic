{
  "presets": [
    [
      "env",
      {
        "modules": false,
        "targets": {
          "browsers": "> 1%",
          "uglify": true
        },
        "useBuiltIns": true
      }
    ],
    "react"
  ],
  "plugins": [
    "syntax-dynamic-import",
    "transform-object-rest-spread",
    "lodash",
    ["css-modules-transform", {
      "preprocessCss": "./config/webpack/loaders/sass.js",
      "generateScopedName": "[name]__[local]___[hash:base64:5]",
      "extensions": [
        ".scss",
        ".sass"
      ]
    }],
    [
      "transform-class-properties",
      {
        "spec": true
      }
    ]
  ]
}
