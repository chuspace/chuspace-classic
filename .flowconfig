[ignore]
.*/node_modules/fbjs/.*
.*/node_modules/immutable/.*
.*/vendor/*

[include]

[libs]

[options]
module.name_mapper.extension='sass' -> '<PROJECT_ROOT>/app/javascript/flow-types/WebpackAsset.js.flow'
module.name_mapper.extension='module.sass' -> '<PROJECT_ROOT>/app/javascript/flow-types/WebpackAsset.js.flow'
module.name_mapper.extension='png' -> '<PROJECT_ROOT>/app/javascript/flow-types/WebpackAsset.js.flow'
module.name_mapper.extension='jpg' -> '<PROJECT_ROOT>/app/javascript/flow-types/WebpackAsset.js.flow'
module.name_mapper.extension='svg' -> '<PROJECT_ROOT>/app/javascript/flow-types/WebpackAsset.js.flow'
module.system.node.resolve_dirname=node_modules
module.system.node.resolve_dirname=./app/javascript
module.name_mapper='^editor/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/editor/\1'
module.name_mapper='^controller/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/controller/\1'
module.name_mapper='^custom-elements/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/custom-elements/\1'
module.name_mapper='^helpers/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/helpers/\1'
module.name_mapper='^styles/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/styles/\1'
module.name_mapper='^flow-types/\(.*\)$' -> '<PROJECT_ROOT>/app/javascript/flow-types/\1'

esproposal.class_static_fields=enable
esproposal.class_instance_fields=enable
esproposal.decorators=ignore
